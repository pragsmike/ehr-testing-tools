#!/usr/bin/env bash
# Runs README.md's own "What you get" section, verbatim, under
# per-step exit-code assertions PLUS a real output comparison against
# each pair's own expected-output fence (ADR-0129 Q4(a); manual-review
# dimension 1: this section is cited by docs/manual/06-breaking-data-
# on-purpose.md but, before this script, nothing re-ran it against the
# live tree). Mirrors bin/quickstart-demo's own expect/expect_eval
# shape (ADR-0004, R23); the per-pair output check is new (see
# `ehrt.docs-tooling.strip-fresh`'s own header comment for why a
# literal byte-diff cannot work here: README.md's own ```clojure
# fences are hand-formatted, elided excerpts, not verbatim CLI output).
#
# The block between the BEGIN/END markers is read by
# `ehrt.docs-tooling.strip-fresh` (via the exercised-sources register,
# components/docs-tooling/resources/docs-tooling/exercised-sources.edn)
# to prove this script and README.md's own two "What you get" pairs
# teach the identical commands, in the identical order (README.md's
# own "See it run" ```bash fence, ed-tuesday, is a DIFFERENT
# register row's own concern -- not this one, correctly excluded by
# the extraction layer's own pairing-adjacency rule, not by anything
# this script does). Integration-tier only (`make integration`), never
# per-push CI.
set -uo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)" || exit 2
cd -- "$repo_root" || exit 2

fail() {
  echo "FAIL: $1" >&2
  exit 1
}

STEP=0
LOG_DIR="$(mktemp -d)"
trap 'rm -rf "$LOG_DIR"' EXIT

# expect CODE CMD...  Same shape as bin/demo-exerciser-ed-tuesday's own
# wrapper: asserts CMD's own exit code, CAPTURES stdout/stderr BY
# REDIRECT into this step's own log file (so the LAST command in a
# multi-command pair can be diffed against that pair's own
# expected-output fence afterward) -- never `tee`, which returns its OWN exit status (ADR-0152).
expect() {
  local want="$1"; shift
  STEP=$((STEP + 1))
  "$@" > "$LOG_DIR/step-$STEP.out" 2> "$LOG_DIR/step-$STEP.err"
  local got=$?
  cat "$LOG_DIR/step-$STEP.out"
  cat "$LOG_DIR/step-$STEP.err" >&2
  if [ "$got" -ne "$want" ]; then
    fail "'$*' exited $got, expected $want"
  fi
}

echo "== readme-what-you-get: README.md's What you get section, verbatim, asserted =="

# Script-only apparatus, not a taught line: safely re-runnable.
rm -rf out/demo-mutants

# BEGIN what-you-get commands (verbatim from README.md's What you get section)
expect 0 bin/ehrt gate fhir test-fixtures/fhir/storefront-patient.json

expect 0 bin/ehrt corpus mutate test-fixtures/fhir/storefront-patient.json \
  --operator-id remove-required-element \
  --locator-path entry[0].resource.resourceType \
  --out-dir out/demo-mutants
expect 1 bin/ehrt gate fhir out/demo-mutants
# END what-you-get commands

echo "== readme-what-you-get: checking each pair's own expected output =="

# Pair 0's own last (only) command is step 1; pair 1's own last command
# is step 3 (step 2 is the mutate call, not itself paired with an
# output fence -- README.md's own text pairs the fence with the
# BLOCK's own last command, "gate fhir out/demo-mutants").
clojure -X:dev ehrt.docs-tooling.strip-fresh/paired-output-check! \
  :source '"README.md"' :fence-lang '"bash"' :pair-index 0 \
  :actual-file "\"$LOG_DIR/step-1.out\"" \
  || fail "pair 0's own real output did not match README.md's own expected fence"

clojure -X:dev ehrt.docs-tooling.strip-fresh/paired-output-check! \
  :source '"README.md"' :fence-lang '"bash"' :pair-index 1 \
  :actual-file "\"$LOG_DIR/step-3.out\"" \
  || fail "pair 1's own real output did not match README.md's own expected fence"

# Tree-clean postcondition (ADR-0005): every write path above lands
# under the gitignored /out/.
dirty="$(git status --porcelain)"
if [ -n "$dirty" ]; then
  fail "tree not clean after a full run (ADR-0005 postcondition violated):
$dirty"
fi

echo "== readme-what-you-get: every command asserted, both pairs matched, tree clean =="
