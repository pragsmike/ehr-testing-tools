#!/usr/bin/env bash
# Nightly drift check between this repo's authoritative palgebra/ files
# and the copies ehr-testing-sim vendored into its string-diagram skill
# (that repo's ADR-0016, pinned at vendoring time to a commit of this
# repo). Tools is the repo ADR-0001 permits to know about sim, so the
# comparison lives here rather than there. Byte-identical is the
# invariant, modulo exactly sim's own provenance header on the vendored
# copy (ADR-0016 ruling 2) -- no fuzzier normalization, and this repo's
# own authoritative file is never itself stripped of anything.
#
# Not hermetic: reads a sibling ehr-testing-sim checkout, subprocess/
# filesystem-only, same coupling rule ADR-0013 already established for
# the sim-harness test suite (test-integration/ehr_testing_tools/
# sim_harness.clj) -- never a classpath/deps.edn dependency. Clean-skips
# (exit 0) when the sibling checkout is absent, same as that suite does.
set -uo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)" || exit 2
cd -- "$repo_root" || exit 2

sim_repo_dir="${SIM_REPO_DIR:-../ehr-testing-sim}"

if [ ! -d "$sim_repo_dir" ]; then
  echo "SKIP: $sim_repo_dir not found -- this check compares against ehr-testing-sim's vendored palgebra copies, sibling-checkout only (never a classpath/deps.edn dependency, ADR-0013's coupling rule); clone it alongside this repo to run this check." >&2
  exit 0
fi

# Strips the 4-line provenance prefix + its trailing blank "#" separator
# line that ADR-0016 prepends to every vendored .txt example (ruling 2).
# Applies only to sim's copy -- this repo's own file carries no such
# header and is never passed through this function.
strip_txt_header() {
  tail -n +6 "$1"
}

# Strips the "# Vendored copy." ... "# Vendored per ADR-0016." block
# (and its bracketing "# ---...---" delimiter lines, and the one blank
# line right after) that ADR-0016 inserts after the module docstring of
# the vendored .py file. Keyed on the two literal anchor lines ADR-0016
# ruling 2 fixes the wording of -- not on "any dashed comment line",
# which would also match this script's own pre-existing section-header
# delimiters ("# --- Data model ---" and friends) elsewhere in the
# file. One line of lookback buffering drops the opening delimiter line
# once the anchor confirms it really was the provenance block's own
# opening, not an ordinary section header.
strip_py_header() {
  awk '
    function flush() { if (have_pending) { print pending } have_pending = 0 }
    function discard() { have_pending = 0 }
    $0 == "# Vendored copy." { discard(); in_block = 1; next }
    in_block && $0 == "# Vendored per ADR-0016." { at_closing_delim = 1; next }
    in_block && at_closing_delim { at_closing_delim = 0; after_close = 1; next }
    in_block && after_close {
      after_close = 0; in_block = 0
      if ($0 == "") next
      pending = $0; have_pending = 1; next
    }
    in_block { next }
    { flush(); pending = $0; have_pending = 1 }
    END { flush() }
  ' "$1"
}

any_fail=0

check_pair() {
  local label="$1" tools_rel="$2" sim_rel="$3" strip_fn="$4"
  local tools_file="$repo_root/$tools_rel"
  local sim_file="$sim_repo_dir/$sim_rel"

  if [ ! -f "$tools_file" ]; then
    echo "FAIL: missing authoritative file $tools_rel" >&2
    any_fail=1
    return
  fi
  if [ ! -f "$sim_file" ]; then
    echo "FAIL: missing vendored copy $sim_rel in $sim_repo_dir" >&2
    any_fail=1
    return
  fi

  if ! diff -u "$tools_file" <("$strip_fn" "$sim_file") \
      > /tmp/palgebra-drift-"$label".diff; then
    echo "FAIL: palgebra drift detected in $label" >&2
    echo "  $tools_rel (this repo, authoritative)" >&2
    echo "  vs $sim_repo_dir/$sim_rel (vendored, sim's ADR-0016)" >&2
    echo "  no longer match once sim's own provenance header is stripped." >&2
    echo "  Remedy: a re-vendor session in ehr-testing-sim against this repo's" >&2
    echo "  current HEAD (see that repo's notes/ADRs.md ADR-0016), or a" >&2
    echo "  deliberate divergence ADR there if this drift is intentional --" >&2
    echo "  never a silent edit on either side." >&2
    cat /tmp/palgebra-drift-"$label".diff >&2
    any_fail=1
  else
    echo "OK: $label matches"
  fi
}

check_pair "resource_equations_to_mermaid.py" \
  "components/palgebra/tools/resource_equations_to_mermaid.py" \
  ".agents/skills/string-diagram/tools/resource_equations_to_mermaid.py" \
  strip_py_header

check_pair "ai-study-equations.txt" \
  "components/palgebra/examples/ai-study-equations.txt" \
  ".agents/skills/string-diagram/examples/ai-study-equations.txt" \
  strip_txt_header

check_pair "lemon-pie-equations.txt" \
  "components/palgebra/examples/lemon-pie-equations.txt" \
  ".agents/skills/string-diagram/examples/lemon-pie-equations.txt" \
  strip_txt_header

check_pair "decision-monad-equations.txt" \
  "components/palgebra/examples/decision-monad-equations.txt" \
  ".agents/skills/string-diagram/examples/decision-monad-equations.txt" \
  strip_txt_header

if [ "$any_fail" -ne 0 ]; then
  exit 1
fi
