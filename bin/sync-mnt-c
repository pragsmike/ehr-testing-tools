#!/usr/bin/env bash
# Sanctioned sync path for the /mnt/c clone (post-Wave-D cleanup
# session, 2026-08-02, notes/ADRs.md ADR-0030 J4c): the /mnt/c clone is
# kept read-only (J4a, attrib.exe +R over the whole tree including
# .git, verified by a real blocked write) so a misdirected Edit/Write
# errors instead of silently landing there
# (feedback-dual-clone-edit-hazard, fired four times in Wave D stage D3
# alone despite a cited prior lesson) -- this script is the ONLY
# documented way that clone ever moves: clear the read-only state,
# fast-forward from origin, restore the read-only state. Never edit
# files there directly, and never git-commit/push from it (J4b's own
# reject-all hooks refuse that regardless) -- the ext4 clone
# (~/src/ehr-testing-tools) is the clone of record for all real work.
#
# Usage: bin/sync-mnt-c [path-to-mnt-c-clone]
# Defaults to $MNT_C_DIR, or this machine's own known location.
set -euo pipefail

mnt_c_dir="${1:-${MNT_C_DIR:-/mnt/c/Users/prags/Documents/ehr-testing-tools}}"

if [ ! -d "$mnt_c_dir/.git" ]; then
  echo "ERROR: $mnt_c_dir is not a git checkout -- refusing to touch it." >&2
  echo "  Override the path with MNT_C_DIR or bin/sync-mnt-c <path>." >&2
  exit 2
fi

if ! command -v attrib.exe >/dev/null 2>&1; then
  echo "ERROR: attrib.exe not reachable -- this script requires WSL2's" >&2
  echo "  Windows interop (attrib.exe/wslpath on PATH)." >&2
  exit 2
fi

win_path="$(wslpath -w "$mnt_c_dir")"

echo "== clearing read-only state on $mnt_c_dir ==" >&2
attrib.exe -R "$win_path\\*" /S /D >/dev/null

echo "== git pull --ff-only ($mnt_c_dir) ==" >&2
git -C "$mnt_c_dir" pull --ff-only

echo "== restoring read-only state on $mnt_c_dir ==" >&2
attrib.exe +R "$win_path\\*" /S /D >/dev/null

echo "OK: $mnt_c_dir synced and re-locked read-only." >&2
