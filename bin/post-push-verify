#!/usr/bin/env bash
# Post-push verification (R13, ADR-0122 "Both a." part (b); ADR-0127):
# the build-session skill's own step 7 (message verification) plus
# AR-RL2-5's own added ASCII line (`notes/ADRs.md` ADR-0092 H-6) and a
# one-shot CI-status report, as one script -- run immediately after a
# `git push`, never before.
#
# Usage: bin/post-push-verify [<base-sha>] [<tip-sha>]
#
#   <base-sha>  Start of the pushed range, exclusive (default: origin's
#               PRE-push tip, read from the remote-tracking ref's own
#               reflog -- `origin/<branch>@{1}` -- because `git push`
#               itself fast-forwards `origin/<branch>` to what it just
#               pushed, so that ref's CURRENT value is the post-push
#               tip and says nothing about what the push added. Falls
#               back to `git merge-base <tip> origin/<branch>`, and
#               FAILS LOUDLY when neither is derivable rather than
#               quietly narrowing the range (review-3 D1-6).
#   <tip-sha>   End of the pushed range, inclusive (default: HEAD).
#
# Three checks:
#   1. Remote tip == local HEAD (the branch actually landed what this
#      checkout has).
#   2. Per-commit ASCII check over the pushed range (<base-sha>..<tip-
#      sha>) -- `git log --format=%B <range> | LC_ALL=C grep -n
#      '[^ -~]'`, expected EMPTY (AR-RL2-5, standing ceremony
#      boilerplate, no new repo test).
#   3. The CI run triggered for <tip-sha> -- polled ONCE, printed,
#      never waited on to conclusion (AR-CI-4's own reservation: watch-
#      to-conclusion is for a session whose own claim is about CI).
#
# Read-only besides the one `git fetch`; never pushes.
set -uo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)" || exit 2
cd -- "$repo_root" || exit 2

usage() {
  cat <<'EOF'
Usage: bin/post-push-verify [<base-sha>] [<tip-sha>]

Verifies a push just landed correctly: remote tip == local HEAD (or
<tip-sha>), every commit message in (<base-sha>..<tip-sha>] is pure
ASCII, and reports (does not wait for) the CI run triggered at the
tip. <base-sha> defaults to origin's pre-push tip (the previous value
of origin/<branch>, from that ref's reflog), so a push carrying N
commits is checked over all N; <tip-sha> defaults to HEAD.
EOF
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi

tip_sha="${2:-HEAD}"
tip_sha="$(git rev-parse --verify "${tip_sha}^{commit}")" || { echo "FAIL: bad tip-sha" >&2; exit 2; }

branch="$(git rev-parse --abbrev-ref HEAD)"

# review-3 D1-6: the default base used to be `${tip_sha}^1` -- the
# tip's own first parent, i.e. ALWAYS exactly one commit, whatever the
# push actually carried. Three live pushes this arc spanned 4, 3, and 1
# commits; the first two had their earlier messages checked by nobody.
# The parent link is a property of the commit graph, which cannot know
# what was pushed; the remote-tracking ref's reflog can, and does.
#
# Derived BEFORE this script's own `git fetch` (check 1, below), so a
# fetch that moves origin/<branch> cannot shift the answer underneath
# the range that is about to be checked.
derive_default_base() {
  local candidate
  # (a) origin/<branch>'s own previous value = origin's pre-push tip.
  candidate="$(git rev-parse --verify --quiet "origin/${branch}@{1}^{commit}" 2>/dev/null)" || candidate=""
  if [ -n "$candidate" ] && [ "$candidate" != "$tip_sha" ] &&
     git merge-base --is-ancestor "$candidate" "$tip_sha" 2>/dev/null; then
    printf '%s' "$candidate"
    return 0
  fi
  # (b) Fallback for a remote-tracking ref with no usable reflog (a
  #     fresh mirror, reflogs disabled): the merge-base with the ref as
  #     it stands. Correct while the ref still trails the tip; refused
  #     when it already equals the tip, because an empty range checks
  #     nothing and would repeat D1-6's own silent under-coverage.
  candidate="$(git merge-base "$tip_sha" "origin/${branch}" 2>/dev/null)" || candidate=""
  if [ -n "$candidate" ] && [ "$candidate" != "$tip_sha" ]; then
    printf '%s' "$candidate"
    return 0
  fi
  return 1
}

base_sha="${1:-}"
if [ -z "$base_sha" ]; then
  base_sha="$(derive_default_base)" || base_sha=""
  if [ -z "$base_sha" ]; then
    echo "FAIL: could not derive a default base-sha from origin/${branch}'s pre-push tip (pass one explicitly)" >&2
    exit 2
  fi
else
  base_sha="$(git rev-parse --verify "${base_sha}^{commit}")" || { echo "FAIL: bad base-sha" >&2; exit 2; }
fi

echo "== bin/post-push-verify ($branch, range ${base_sha:0:8}..${tip_sha:0:8}) =="
echo

# --- 1. Remote tip == local HEAD -----------------------------------------
echo "-- 1. Remote tip vs HEAD --"
if ! git fetch origin "$branch" --quiet; then
  echo "FAIL: git fetch origin $branch failed" >&2
  exit 1
fi
remote_tip="$(git rev-parse "origin/$branch")"
if [ "$remote_tip" = "$tip_sha" ]; then
  echo "OK: origin/$branch ($remote_tip) matches tip ($tip_sha)"
else
  echo "FAIL: origin/$branch ($remote_tip) does NOT match tip ($tip_sha)" >&2
  exit 1
fi
echo

# --- 2. Per-commit ASCII check over the pushed range ---------------------
echo "-- 2. Per-commit ASCII check, ${base_sha:0:8}..${tip_sha:0:8} --"
ascii_hits="$(git log --format=%B "${base_sha}..${tip_sha}" | LC_ALL=C grep -n '[^ -~]' || true)"
if [ -z "$ascii_hits" ]; then
  echo "OK: every commit message in range is pure ASCII"
else
  echo "FAIL: non-ASCII byte(s) found in commit message range:" >&2
  echo "$ascii_hits" | sed 's/^/  /' >&2
  exit 1
fi
echo

# --- 3. CI run for the tip, polled once, never awaited -------------------
echo "-- 3. CI run at tip ($tip_sha) --"
if ! command -v gh >/dev/null 2>&1; then
  echo "SKIP: gh not on PATH -- cannot report CI status"
else
  # Joined with \x1f (unit separator), not @tsv/tab: bash `read` treats
  # tab as IFS-whitespace and silently COLLAPSES adjacent delimiters,
  # dropping an empty field (e.g. an in-progress run's empty
  # .conclusion) and misaligning every field after it -- the exact bug
  # bin/preflight's own smoke test caught first.
  # stderr goes to its OWN file, never into `run_line` (ADR-0155,
  # register L2-6). A `2>&1` here folded a broken gh's error text into
  # the status FIELD -- "status=error: HTTP 401: Bad credentials
  # conclusion=<pending>" -- which skims as "pending", i.e. as a run
  # that exists and is still going. The exit stays 0 either way: check 3
  # is advisory by AR-CI-4, and author ruling R4-Q3 (a) deliberately
  # does NOT reopen that. Only the rendering changes.
  gh_err="$(mktemp)"
  run_line="$(gh run list --branch "$branch" --json headSha,conclusion,status,url \
    --jq "map(select(.headSha == \"$tip_sha\")) | .[0] | [.status, .conclusion, .url] | join(\"\")" 2>"$gh_err")"
  gh_status=$?
  if [ "$gh_status" -ne 0 ]; then
    echo "UNKNOWN: CI status could not be determined -- 'gh run list' exited $gh_status:"
    sed 's/^/  /' "$gh_err"
    echo "DISCLOSED: check 3 is advisory (AR-CI-4) and this script's exit is unchanged; a query that FAILED reports UNKNOWN, never a status line."
  elif [ -z "$run_line" ] || [ "$run_line" = "null" ]; then
    echo "DISCLOSED: no CI run found yet for $tip_sha (may not have been triggered/indexed yet)"
  else
    IFS=$'\x1f' read -r status conclusion url <<< "$run_line"
    echo "CI run for $tip_sha: status=$status conclusion=${conclusion:-<pending>} $url"
    echo "DISCLOSED: reported once, not awaited to conclusion (AR-CI-4)"
  fi
  rm -f "$gh_err"
fi

echo
echo "== bin/post-push-verify complete =="
exit 0
