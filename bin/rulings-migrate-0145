# The ADR each row cites, and the successor a SUPERSEDED row names.
ROW_ADR = {}
ROW_SUPERSEDED_BY = {
    "register-append-contract":  ("rulings-row-contract", "0145"),
    "stable-tag-author-only":    ("tag-law", "0057"),
    "footnote-append-in-place":  ("footnote-marker-only", "0102"),
    "user-manual-deferral":      ("user-manual-opened", "0112"),
    "engine-flake-seed-licence": ("generative-failure-is-new-finding", "0122"),
    "collision-guard-warn":      ("exact-name-resolution", "0133"),
}

# Rows this session takes itself; they have no bullet in the old file.
OWN_ROWS = [
    ("rulings-row-contract", "0145"),
    ("skill-rules-not-history", "0145"),
    ("reading-sets-header-cap", "0145"),
]


# ---------------------------------------------------------------------
# mechanics
# ---------------------------------------------------------------------

def base_lines():
    return subprocess.check_output(
        ["git", "show", BASE + ":" + RULINGS], text=True).split("\n")


def block_spans(lines):
    """(start, end) 0-based half-open spans for every entry in BLOCKS,
    asserted against the prefix each entry carries."""
    starts = [b[0] - 1 for b in BLOCKS]
    spans = []
    for i, (start, prefix, dest) in enumerate(BLOCKS):
        s = start - 1
        if not lines[s].startswith(prefix):
            sys.exit(f"FAIL: {RULINGS}:{start} is {lines[s]!r}, expected prefix "
                     f"{prefix!r} -- the tree has drifted from {BASE}")
        e = starts[i + 1] if i + 1 < len(starts) else len(lines)
        while e > s and lines[e - 1].strip() == "":
            e -= 1
        spans.append((s, e, dest))
    return spans


def adr_path(num):
    for f in sorted(os.listdir(ADR_DIR)):
        if f.startswith(num + "-"):
            return os.path.join(ADR_DIR, f)
    sys.exit(f"FAIL: no ADR file for {num}")


def adr_for_row(slug):
    if slug in ROW_ADR:
        return ROW_ADR[slug]
    sys.exit(f"FAIL: no ADR recorded for row R-{slug}")


def build_row_adrs():
    """Every row's ADR cite comes from the block its bullet sits in, so a
    row cannot cite an ADR the bullet did not come from."""
    lines = base_lines()
    spans = block_spans(lines)
    for line, cls, slug, _why in BULLETS:
        if slug is None:
            continue
        for s, e, dest in spans:
            if s < line <= e:
                ROW_ADR[slug] = dest
                break
        else:
            sys.exit(f"FAIL: bullet at line {line} sits in no block")
    for slug, num in OWN_ROWS:
        ROW_ADR[slug] = num


def render_register():
    out = [PREAMBLE.rstrip("\n"), ""]
    ordered = [(l, c, s) for (l, c, s, _w) in BULLETS if s is not None]
    ordered += [(10 ** 9, "STANDING", s) for s, _n in OWN_ROWS]
    seen = set()
    for _line, _cls, slug in ordered:
        if slug in seen:
            sys.exit(f"FAIL: duplicate slug R-{slug}")
        seen.add(slug)
        if slug not in ROWS:
            sys.exit(f"FAIL: no authored rule text for R-{slug}")
        body = ROWS[slug]
        tail = f" -- ADR-{adr_for_row(slug)}"
        if slug in ROW_SUPERSEDED_BY:
            succ, num = ROW_SUPERSEDED_BY[succ_key(slug)]
            tail += f" SUPERSEDED-BY R-{succ} (ADR-{num})"
        out.append(textwrap.fill(f"- **R-{slug}** -- {body}{tail}",
                                 width=WRAP, subsequent_indent="  ",
                                 break_long_words=False, break_on_hyphens=False))
    for slug in ROWS:
        if slug not in seen:
            sys.exit(f"FAIL: authored rule text R-{slug} is used by no bullet")
    return "\n".join(out) + "\n"


def succ_key(slug):
    return slug


def append_block(path, text):
    with open(path, encoding="utf-8") as fh:
        cur = fh.read()
    sep = "" if cur.endswith("\n") else "\n"
    if DATED_HEADING not in cur:
        cur += sep + "\n" + DATED_HEADING + "\n\n" + text.rstrip("\n") + "\n"
    else:
        cur += sep + "\n" + text.rstrip("\n") + "\n"
    return cur


def census_markdown():
    lines = base_lines()
    spans = block_spans(lines)
    print("#### 1. Blocks, and where each one goes\n")
    print("| # | block | lines | bullets | verbatim to |")
    print("|---:|---|---:|---:|---|")
    by_line = {b[0]: b for b in BULLETS}
    for i, (s, e, dest) in enumerate(spans):
        head = " ".join(lines[s].lstrip("# ").split())
        n = sum(1 for (ln, *_r) in BULLETS if s < ln <= e)
        print(f"| {i} | {head[:58]} | {e - s} | {n} | adr:{dest} |")
    print()
    counts = {"STANDING": 0, "ARC-LOCAL": 0, "SUPERSEDED": 0}
    for _l, c, _s, _w in BULLETS:
        counts[c] += 1
    dupes = len(BULLETS) - len({b[0] for b in BULLETS})
    print(f"**{len({b[0] for b in BULLETS})} bullets across {len(spans) - 1} "
          f"blocks**, {len(BULLETS)} classification entries "
          f"({dupes} bullet(s) yield more than one row): "
          f"{counts['STANDING']} STANDING, {counts['ARC-LOCAL']} ARC-LOCAL, "
          f"{counts['SUPERSEDED']} SUPERSEDED.\n")
    print("#### 2. Per-bullet classification\n")
    print("| line | class | row | the sentence that decides it |")
    print("|---:|---|---|---|")
    for ln, cls, slug, why in BULLETS:
        print(f"| {ln} | {cls} | {('R-' + slug) if slug else '--'} | {why} |")


def verify():
    lines = base_lines()
    spans = block_spans(lines)
    cache, ok, missing, moved = {}, 0, [], 0
    for s, e, dest in spans:
        path = adr_path(dest)
        if path not in cache:
            cache[path] = open(path, encoding="utf-8").read()
        block = "\n".join(lines[s:e])
        moved += e - s
        if block in cache[path]:
            ok += 1
        else:
            missing.append((s + 1, path))
    print(f"blocks moved          : {len(spans)}")
    print(f"blocks found VERBATIM : {ok}")
    print(f"blocks missing        : {len(missing)}  {missing if missing else ''}")
    print(f"moved lines total     : {moved}")
    if missing:
        sys.exit("FAIL: a moved block is not present verbatim at its destination")


def main():
    build_row_adrs()
    if "--markdown" in sys.argv:
        census_markdown()
        return
    if "--verify" in sys.argv:
        verify()
        return
    dry = "--dry-run" in sys.argv

    lines = base_lines()
    live = open(RULINGS, encoding="utf-8").read().split("\n")
    if live[:len(lines)] != lines and "".join(live) != "".join(lines):
        sys.exit(f"FAIL: {RULINGS} has drifted from {BASE}; re-key the table")
    spans = block_spans(lines)

    # multiset identity: every line of the old file is either moved into a
    # destination or is a blank separator between blocks.
    moved_lines, writes = [], {}
    for s, e, dest in spans:
        path = adr_path(dest)
        block = "\n".join(lines[s:e])
        moved_lines.extend(lines[s:e])
        writes[path] = append_block(path, block) if path not in writes else \
            writes[path] + "\n" + block.rstrip("\n") + "\n"
    old_nonblank = [l for l in lines if l.strip()]
    new_nonblank = [l for l in moved_lines if l.strip()]
    if sorted(old_nonblank) != sorted(new_nonblank):
        sys.exit(f"FAIL: multiset identity broken -- {len(old_nonblank)} lines in, "
                 f"{len(new_nonblank)} lines out")

    register = render_register()
    print(f"blocks moved     : {len(spans)}")
    print(f"lines moved      : {len(moved_lines)} ({len(new_nonblank)} non-blank)")
    print(f"rows written     : {register.count(chr(10) + '- **R-') + 1}")
    print(f"{RULINGS}        : {len(lines)} -> {len(register.split(chr(10)))} lines")
    if dry:
        print("(--dry-run: nothing written)")
        return
    for path, text in writes.items():
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(text)
    with open(RULINGS, "w", encoding="utf-8") as fh:
        fh.write(register)
    print("written; run --verify")


if __name__ == "__main__":
    main()
