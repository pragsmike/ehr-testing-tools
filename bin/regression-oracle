#!/usr/bin/env bash
# Regression-oracle harness (post-Wave-D cleanup session, 2026-08-02,
# J1/J2, notes/ADRs.md ADR-0030): runs ehrt.oracle.digest -- fixed-seed
# golden runs for every vendored root -- against two commits' own
# component code in disposable git worktrees, SHA-256-digests every
# output file, and diffs the two digest manifests byte-for-byte. THIS
# is what a regression-oracle claim means in this repo (build-session
# skill's own VERIFICATION section, J2): a test-count or assertion-count
# comparison is NOT an oracle and may not be reported as one.
#
# Dated note (2026-08-05, standing-equipment promotion, `notes/ADRs.md`
# promotion ADR, AR-P-2/AR-P-3): digest.clj retired out of
# `bin/oracle-src` into `components/oracle`, a real Polylith component
# -- J2's own "digest.clj is always read from THIS checkout, never from
# either worktree" design is CLOSED here: each side now reads its OWN
# worktree's own `components/oracle` (or, transitionally, that
# worktree's own `bin/oracle-src`, for a ref from before the
# promotion -- the FALLBACK branch in `oracle_deps_for`, below). Because
# the two sides can now genuinely run two DIFFERENT digest.clj sources
# (not just two different component versions under the SAME test code,
# the pre-promotion design's whole premise), a SOUNDNESS CHECK runs
# first: the two sides' own digest.clj is diffed over the WHOLE FILE
# MINUS its leading namespace docstring -- requires included. Identical
# there, or differing only in that docstring, proceeds silently; any
# other diff -- a `:require`/`:import` change included -- demands
# `--declared-digest-change` (recorded in the manifest header below) or
# this script aborts rather than let an unsound comparison masquerade
# as a byte-identity bracket. WIDENED 2026-08-19 (ADR-0156, author
# ruling R4-Q6 (iii) (c)): it used to compare only what fell after the
# first `(defn` line, so a require change passed silently.
#
# Usage: bin/regression-oracle <baseline-ref> <target-ref> [--declared-digest-change]
#
# Prints both manifests, then either "IDENTICAL" (exit 0) or "DIFFERS"
# (exit 1, with a diff of the two manifests on stderr) -- a DIFFERS
# result is a real finding: STOP and escalate with the evidence, per
# this session's own J1 ruling, never patched under this script's own
# invocation.
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

declared_change="no"
positional=()
for arg in "$@"; do
  if [ "$arg" = "--declared-digest-change" ]; then
    declared_change="yes"
  else
    positional+=("$arg")
  fi
done
baseline_ref="${positional[0]:?usage: bin/regression-oracle <baseline-ref> <target-ref> [--declared-digest-change]}"
target_ref="${positional[1]:?usage: bin/regression-oracle <baseline-ref> <target-ref> [--declared-digest-change]}"

work="$(mktemp -d)"
cleanup() {
  rm -rf "$work"
  git -C "$repo_root" worktree prune >/dev/null 2>&1 || true
}
trap cleanup EXIT


# EXTRACTED 2026-08-27 (arc 4 sweep 1, ADR-0175 ruling E1): the per-side
# resolution functions (`oracle_wiring_for`, `sim_brick_dir_for`,
# `person_sim_dep_for`, `oracle_source_path_for`), the `digest_body_of`
# awk, `run_one`'s worktree-and-classpath machinery, and the soundness
# check now live in `bin/oracle-lib.sh`, byte-identical, so that
# `bin/ground-truth-bracket` runs the SAME machinery rather than a
# second copy of it. Nothing about THIS script's behaviour changed with
# the move; what is below is its own half -- whole-file digests, the
# manifest diff, and the IDENTICAL/DIFFERS verdict that
# `rulings.md#R-oracle-script-contract` names.
# shellcheck source=bin/oracle-lib.sh
. "$repo_root/bin/oracle-lib.sh"


manifest_for() {
  local out="$1"
  (cd "$out" && sha256sum -- *.edn | sort -k2)
}

oracle_soundness_check "$work" "$baseline_ref" "$target_ref" "$declared_change"

echo "== running oracle at baseline ($baseline_ref) ==" >&2
run_one "$baseline_ref" baseline
echo "== running oracle at target ($target_ref) ==" >&2
run_one "$target_ref" target

manifest_for "$work/out-baseline" > "$work/baseline.sha256"
manifest_for "$work/out-target" > "$work/target.sha256"

echo "--- baseline ($baseline_ref) ---"
cat "$work/baseline.sha256"
echo "--- target ($target_ref) ---"
cat "$work/target.sha256"
echo "--- declared-digest-change: $declared_change (soundness: $sound outside the leading docstring) ---"

if diff -u "$work/baseline.sha256" "$work/target.sha256" > "$work/diff.txt"; then
  echo "IDENTICAL: every root's digest matches between $baseline_ref and $target_ref"
  exit 0
else
  echo "DIFFERS: digests diverge between $baseline_ref and $target_ref -- STOP, escalate (do not fix under this script)" >&2
  cat "$work/diff.txt" >&2
  exit 1
fi
