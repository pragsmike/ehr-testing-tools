#!/usr/bin/env bash
# Runs README.md's Quickstart fenced block, verbatim, under per-step exit-
# code assertions (DOC-5, notes/tools/agents/plans/user-docs.md, tools'
# own pre-Polylith provenance). Invoke via `make quickstart` (ADR-0004's
# own thin Makefile, R23) or directly.
#
# Invariant per taught command: its real exit code equals what README.md's
# own exit-code prose commits to for that exact invocation, or -- where the
# README states no specific code -- what Step 0's evidence run measured
# (notes/tools/prompts/2026-07-26-doc5-executable-quickstart.md's commit
# body is the source of truth for every number below). A bare `set -e`
# cannot make this distinction: `gate fhir`'s taught rejection is exit 1 by
# design (a real validator rejecting real findings), not a script failure --
# `set -e` would abort on it as though it were one. Hence the explicit
# `expect` wrapper below instead of `-e`.
#
# The block between the BEGIN/END markers is read by `make quickstart-fresh`
# (`ehrt.docs-tooling.quickstart-fresh`, its poly-era replacement, green in the
# per-push lane -- components/docs-tooling/test/ehrt/docs_tooling/quickstart_fresh_test.clj)
# to prove this script and README.md's fence teach the identical commands,
# in the identical order. Keep every taught line inside that block, one
# statement per README command, and do not "improve" a command here -- an
# improvement belongs in the README first (AUTHORS-GUIDE.md sec7's craft
# discipline).
set -uo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)" || exit 2
cd -- "$repo_root" || exit 2

fail() {
  echo "FAIL: $1" >&2
  exit 1
}

# expect CODE CMD...  Runs CMD with CMD's own argv (the same word-splitting
# and globbing a user typing CMD directly at this call site would get --
# the function wrapper adds no reinterpretation), asserts its exit status
# is exactly CODE.
expect() {
  local want="$1"; shift
  "$@"
  local got=$?
  if [ "$got" -ne "$want" ]; then
    fail "'$*' exited $got, expected $want"
  fi
}

# expect_eval CODE SNIPPET  Like expect, but for a shell snippet that needs
# a pipeline or a variable assignment (PATIENT_FILE below) rather than one
# invocable command -- eval runs SNIPPET in this shell's own scope, so an
# assignment inside it is visible to the taught lines after this call, the
# same as it would be if a user pasted the README line directly.
expect_eval() {
  local want="$1" snippet="$2"
  eval "$snippet"
  local got=$?
  if [ "$got" -ne "$want" ]; then
    fail "'$snippet' exited $got, expected $want"
  fi
}

echo "== quickstart-demo: README.md's Quickstart, verbatim, asserted =="

# Script-only apparatus, not a taught line (outside BEGIN/END, so
# quickstart-fresh's freshness check never sees it): `corpus generate`'s
# zero-flag --out-dir is now a *derived, stable* path (D9) and rejects
# a rerun into a non-empty one (:out-dir-exists, the determinism probe's
# 2026-07-28 finding) -- this script must be safely re-runnable, so it
# clears its own last run's output first. A first-time reader following
# README.md never needs this: their repo starts clean.
rm -rf out/corpus/synthea-s1-p5 out/corpus/sim-s1-p1 out/demo-mutants out/demo-mutants-report.edn

# BEGIN quickstart commands (verbatim from README.md's Quickstart fence)
expect 0 bin/ehrt help

expect 0 bin/ehrt corpus generate

expect 0 bin/ehrt artifact fetch --name synthea --version 4.0.0
expect 0 bin/ehrt artifact fetch --name temurin-jdk --version 21.0.12+8

expect 0 bin/ehrt corpus generate synthea

expect_eval 0 'PATIENT_FILE=$(ls out/corpus/synthea-s1-p5/fhir/*.json | grep -v -e hospitalInformation -e practitionerInformation | head -1)'
expect 0 bin/ehrt corpus mutate $PATIENT_FILE \
  --operator-id remove-required-element --locator-path entry[0].resource.gender \
  --out-dir out/demo-mutants

expect 0 bin/ehrt artifact fetch --name fhir-validator-cli --version 6.9.12
expect 0 bin/ehrt gate v2 components/corpus/test-fixtures/v2
# gate fhir exits 1 here -- rejected, but not because of this mutation:
# a real Synthea patient already carries hundreds of legitimate profile
# findings before you break anything (Patient.gender isn't required in
# base FHIR) -- see docs/judge-calibration.md
expect 1 bin/ehrt gate fhir out/demo-mutants --report out/demo-mutants-report.edn

expect 0 bin/ehrt check out/corpus/synthea-s1-p5/fhir --expected out/corpus/synthea-s1-p5/fhir

expect 0 bin/ehrt sim run --seed 100 --patients 1

expect 0 clojure -M:poly test :all
# END quickstart commands

# Tree-clean postcondition (ADR-0005): every write path above lands under
# the gitignored /out/, or in the artifact cache outside the repo tree
# entirely -- a full run must leave the tracked tree exactly as it found
# it. A non-empty status here means some taught command wrote somewhere
# ADR-0005 doesn't cover -- a finding about the quickstart, not a bug in
# this script.
dirty="$(git status --porcelain)"
if [ -n "$dirty" ]; then
  fail "tree not clean after a full run (ADR-0005 postcondition violated):
$dirty"
fi

echo "== quickstart-demo: every command asserted, tree clean =="
