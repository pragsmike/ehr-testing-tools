#!/usr/bin/env bash
# Session-start preflight (R13, ADR-0122 "Both a." part (b);
# ADR-0127): the checks a build session's own driving prompt used to
# re-read from prose each time -- build-session SKILL.md's own "Done
# when" list -- as one deterministic, re-runnable script. Read-only:
# reports findings, never fixes them, never pushes, never mutates the
# working tree.
#
# Five checks, each printed as its own labeled section:
#   1. Last five CI runs on the given branch (green/red each) --
#      widened past "just the latest" per quality riders AR-QR-3
#      (`notes/ADRs.md` ADR-0075): a probabilistic red hides behind
#      any single green.
#   2. Edit-root confirmation -- the ext4 clone, never a Windows-
#      mounted /mnt/* checkout (the retired /mnt/c hazard class,
#      `notes/ADRs.md` ADR-0047 AR-C-3; a fresh instance elsewhere is a
#      NEW regression per that ruling, not routine vigilance).
#   3. Tree-clean check, counting untracked files too (`git status
#      --porcelain=v1 --untracked-files=all` -- the tree-clean
#      false-positive class a porcelain call without --untracked=all
#      would miss).
#   4. HEAD-vs-remote tip match (`git fetch`, then compare).
#   5. Last stable-* tag, and whether HEAD is tagged.
#
# Usage: bin/preflight [--branch BRANCH]
#
# THE EXIT CODE IS A CLAIM (ADR-0155, author ruling R4-Q2 (c); register
# rows L2-3 and L2-4). This script exits NON-ZERO when any check prints a
# FINDING:, a FAIL: or an UNKNOWN:, and 0 only when every check it ran
# came back OK/DISCLOSED. It used to `exit 0` unconditionally, which made
# it the ONE ceremony script in bin/ whose status said nothing while
# every other one -- tag-ceremony, post-push-verify's checks 1-2,
# verify-nist-lock, close-scaffold -- is fail-closed. An undeclared
# always-zero exit invites a caller to trust $?.
#
# The OUTPUT is still the artifact a session discloses; the exit code is
# now load-bearing AS WELL, not instead. A finding is reported in full
# and never silently passed (AR-CI-3's own "disclosed, never silently
# passed" shape, extended to every check here, not CI alone).
#
# UNKNOWN: is the third verdict, and the one this script lacked. A check
# that could not MEASURE is not a check that passed. A failed `gh run
# list` used to leave `runs_out` empty, which made the `-n` test false,
# which left any_red/any_pending at 0, which reached the else and printed
# "OK: last five runs all green (or none found)" -- a failed CI query
# rendering as a green CI report, in the script whose whole job at Step 0
# is to establish CI colour.
#
# SKIP: is deliberately NOT fail-closed, and is the one residue. `gh`
# absent from PATH is a property of the machine rather than of CI, and
# making it fatal would leave preflight permanently red on any checkout
# without `gh` while telling the reader nothing it does not already know.
# It prints no OK either, so it cannot be misread as green.
set -uo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)" || exit 2
cd -- "$repo_root" || exit 2

usage() {
  cat <<'EOF'
Usage: bin/preflight [--branch BRANCH]

Session-start preflight: last-five-CI-runs check, edit-root
confirmation, tree-clean check (untracked included), HEAD-vs-remote
tip match, and the last stable-* tag / whether HEAD is tagged.
Read-only, deterministic, no network beyond git/gh, never pushes.

  --branch BRANCH   Branch to check CI runs and remote tip against
                     (default: main)
EOF
}

branch="main"
while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --branch) branch="${2:?--branch requires a value}"; shift 2 ;;
    *) echo "FAIL: unknown argument '$1'" >&2; usage >&2; exit 2 ;;
  esac
done

echo "== bin/preflight ($branch) =="
echo

# Set by any check that finds something, fails, or cannot measure. The
# exit at the bottom of this file is its only consumer.
findings=0

# --- 1. Last five CI runs -----------------------------------------------
echo "-- 1. Last five CI runs on $branch --"
if ! command -v gh >/dev/null 2>&1; then
  echo "SKIP: gh not on PATH -- cannot check CI runs"
else
  # A query that could not answer reports UNKNOWN, never OK (ADR-0155).
  ci_unknown=0
  # Fields joined with \x1f (unit separator), not @tsv/tab: bash `read`
  # treats tab as IFS-whitespace and silently COLLAPSES adjacent
  # delimiters, dropping empty fields (e.g. an in-progress run's empty
  # .conclusion) and misaligning every field after it -- caught live,
  # smoke-testing this script, before this comment existed.
  runs_out="$(gh run list --limit 5 --branch "$branch" --json conclusion,status,displayTitle,headSha,createdAt \
    --jq '.[] | [.status, .conclusion, (.headSha[0:8]), .createdAt, .displayTitle] | join("")' 2>&1)" || {
    echo "FAIL: gh run list failed:"
    echo "$runs_out"
    runs_out=""
    ci_unknown=1
  }
  any_red=0
  any_pending=0
  if [ -n "$runs_out" ]; then
    while IFS=$'\x1f' read -r status conclusion sha created title; do
      [ -z "$status" ] && continue
      if [ "$status" != "completed" ]; then
        mark="PENDING"
        any_pending=1
      elif [ "$conclusion" = "success" ]; then
        mark="green"
      else
        mark="RED"
        any_red=1
      fi
      echo "  $mark  $sha  $created  $title"
    done <<< "$runs_out"
  fi
  if [ "$ci_unknown" -eq 1 ]; then
    echo "UNKNOWN: CI status could not be determined -- the query above FAILED. This is NOT a green report: establish CI colour another way before relying on it."
    findings=1
  elif [ "$any_red" -eq 1 ]; then
    echo "FINDING: a red (completed, non-success) run appears among the last five -- report before proceeding, never silently pass"
    findings=1
  elif [ "$any_pending" -eq 1 ]; then
    echo "DISCLOSED: a run among the last five is still in progress -- not awaited to conclusion (AR-CI-4), not counted as red"
  else
    echo "OK: last five runs all green (or none found)"
  fi
fi
echo

# --- 2. Edit-root confirmation ------------------------------------------
echo "-- 2. Edit-root confirmation --"
case "$repo_root" in
  /mnt/*)
    echo "FAIL: repo root '$repo_root' is under /mnt/ -- a Windows-mounted checkout; the ext4 clone is the only clone of record (ADR-0047 AR-C-3). STOP-AND-REPORT: this is a NEW regression, not a known hazard."
    findings=1
    ;;
  *)
    echo "OK: repo root '$repo_root' is not under /mnt/"
    ;;
esac
echo

# --- 3. Tree-clean check (untracked included) ---------------------------
echo "-- 3. Tree-clean check (untracked included) --"
dirty="$(git status --porcelain=v1 --untracked-files=all)"
if [ -n "$dirty" ]; then
  echo "FINDING: working tree is not clean (untracked files counted):"
  echo "$dirty" | sed 's/^/  /'
  findings=1
else
  echo "OK: working tree clean, including untracked files"
fi
echo

# --- 4. HEAD-vs-remote tip match ----------------------------------------
echo "-- 4. HEAD-vs-remote tip match --"
local_head="$(git rev-parse HEAD)"
if git fetch origin "$branch" --quiet 2>/tmp/preflight-fetch-err.$$; then
  remote_head="$(git rev-parse "origin/$branch")"
  if [ "$local_head" = "$remote_head" ]; then
    echo "OK: local HEAD ($local_head) matches origin/$branch"
  else
    echo "FINDING: local HEAD ($local_head) differs from origin/$branch ($remote_head)"
    findings=1
  fi
else
  echo "FAIL: git fetch origin $branch failed:"
  sed 's/^/  /' /tmp/preflight-fetch-err.$$
  echo "UNKNOWN: HEAD-vs-remote could not be determined -- the fetch above FAILED, so this check did not measure."
  findings=1
fi
rm -f /tmp/preflight-fetch-err.$$
echo

# --- 5. Last stable-* tag / HEAD tagged? ---------------------------------
echo "-- 5. Last stable-* tag / HEAD tagged? --"
last_stable="$(git tag -l 'stable-*' --sort=-creatordate | head -1)"
if [ -z "$last_stable" ]; then
  echo "FINDING: no stable-* tag found in this checkout"
  findings=1
else
  echo "Last stable-* tag: $last_stable ($(git rev-list -n1 "$last_stable"))"
fi
head_tags="$(git tag --points-at HEAD | grep '^stable-' || true)"
if [ -n "$head_tags" ]; then
  echo "OK: HEAD is tagged: $head_tags"
else
  echo "DISCLOSED: HEAD is not currently tagged stable-*"
fi

echo
if [ "$findings" -ne 0 ]; then
  echo "== bin/preflight complete: findings above, exit 1 =="
  exit 1
fi
echo "== bin/preflight complete: no findings, exit 0 =="
exit 0
