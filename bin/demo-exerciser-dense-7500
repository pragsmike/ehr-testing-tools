#!/usr/bin/env bash
# Runs demos/scenarios/dense-7500/README.md's own fenced command
# sequence, verbatim, under per-step exit-code assertions plus that
# README's own named derivations -- R3 (notes/ADRs.md ADR-0113, author
# verbatim): "The demos must be known to work, and exercised as
# documented to make sure they actually play out as written." Same
# expect/expect_eval wrapper shape as bin/demo-exerciser-ed-tuesday
# (ADR-0120) and bin/demo-exerciser-clinic-decade (ADR-0132).
#
# THE EXPENSIVE ONE. Its first taught command generates a 10^5-event
# corpus -- minutes, not seconds, and hundreds of megabytes of peak
# RSS. Integration-tier only (`make integration`), never per-push CI,
# the same tier split its two siblings already use; this script is the
# reason that tier's wallclock moves.
#
# The block between the BEGIN/END markers is read by
# ehrt.docs-tooling.strip-fresh (via the exercised-sources register,
# components/docs-tooling/resources/docs-tooling/exercised-sources.edn)
# to prove this script and the README's own fences teach the identical
# commands, in the identical order. Keep every taught line inside that
# block, one statement per README command, and do not "improve" a
# command here -- an improvement belongs in the README first
# (AUTHORS-GUIDE.md sec7's craft discipline).
set -uo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)" || exit 2
cd -- "$repo_root" || exit 2

fail() {
  echo "FAIL: $1" >&2
  exit 1
}

STEP=0
LOG_DIR="$(mktemp -d)"
export LOG_DIR
trap 'rm -rf "$LOG_DIR"' EXIT

# expect CODE CMD...  Runs CMD with CMD's own argv (no shell
# reinterpretation), asserts its exit status is exactly CODE, and
# CAPTURES stdout/stderr BY REDIRECT into this step's own log file
# under LOG_DIR, then replays them with `cat` -- never `tee`, which
# returns its OWN exit status (ADR-0152).
expect() {
  local want="$1"; shift
  STEP=$((STEP + 1))
  "$@" > "$LOG_DIR/step-$STEP.out" 2> "$LOG_DIR/step-$STEP.err"
  local got=$?
  cat "$LOG_DIR/step-$STEP.out"
  cat "$LOG_DIR/step-$STEP.err" >&2
  if [ "$got" -ne "$want" ]; then
    fail "'$*' exited $got, expected $want"
  fi
}

# expect_eval CODE SNIPPET  Like expect, but for a taught line that
# needs a SHELL -- here, the redirect on the `sim run` line
# (`rulings.md#R-taught-shell-lines-use-expect-eval`).
expect_eval() {
  local want="$1" snippet="$2"
  STEP=$((STEP + 1))
  eval "$snippet" > "$LOG_DIR/step-$STEP.out" 2> "$LOG_DIR/step-$STEP.err"
  local got=$?
  cat "$LOG_DIR/step-$STEP.out"
  cat "$LOG_DIR/step-$STEP.err" >&2
  if [ "$got" -ne "$want" ]; then
    fail "'$snippet' exited $got, expected $want"
  fi
}

echo "== demo-exerciser-dense-7500: demos/scenarios/dense-7500/README.md, verbatim, asserted =="

started_s="$(date +%s)"

# Script-only apparatus, not taught lines (outside BEGIN/END, so
# demo-exerciser-fresh's freshness check never sees them): this script
# must be safely re-runnable, and the README's own Generate section
# states --out-dir is rejected when it already exists non-empty. The
# mkdir is what makes the ground-truth redirect below land whatever
# order a re-run reaches it in; a first-time reader following the
# README top to bottom has already created out/scenarios/ with the
# Generate command and never needs it.
rm -rf out/scenarios/dense-7500 out/scenarios/dense-7500-750.edn
mkdir -p out/scenarios

# BEGIN dense-7500 commands (verbatim from demos/scenarios/dense-7500/README.md)
expect 1 diff demos/scenarios/dense-7500/config.edn demos/scenarios/dense-7500/config-nobed.edn

expect 0 bin/ehrt corpus generate sim --seed 20260824 --patients 7500 --churn \
  --config demos/scenarios/dense-7500/config.edn \
  --out-dir out/scenarios/dense-7500

expect_eval 0 'bin/ehrt sim run --seed 20260824 --patients 750 --churn --config demos/scenarios/dense-7500/config.edn --format ground-truth > out/scenarios/dense-7500-750.edn'
# END dense-7500 commands

ended_s="$(date +%s)"
echo "== demo-exerciser-dense-7500: full run wallclock $((ended_s - started_s))s =="

echo "== demo-exerciser-dense-7500: checking named derivations =="

# THE ONE-KEY DERIVATION. Step 1's own exit code already proved the two
# configs DIFFER; what the README claims is stronger and is what is
# checked here -- that they differ in exactly one line, and that the
# line is `:bed-cycle true`. A diff of two lines, or of one line that
# is not that key, exits 1 the same way and would pass on the exit code
# alone.
removed="$(grep -c '^<' "$LOG_DIR/step-1.out" || true)"
added="$(grep -c '^>' "$LOG_DIR/step-1.out" || true)"
if [ "${removed:-0}" -ne 1 ] || [ "${added:-0}" -ne 0 ]; then
  fail "one-key derivation: config-nobed.edn differs from config.edn by $removed removed and $added added lines, expected 1 and 0"
fi
if [ "$(grep '^<' "$LOG_DIR/step-1.out" | sed 's/^< *//')" != ":bed-cycle true" ]; then
  fail "one-key derivation: the one differing line is not ':bed-cycle true' -- $(grep '^<' "$LOG_DIR/step-1.out")"
fi
echo "  one-key derivation: config-nobed.edn is config.edn less exactly ':bed-cycle true'"

# THE ADDITIVE-PREFIX DERIVATION, re-derived rather than carried as a
# literal. config-bare.edn minus its own closing brace and newline must
# be byte-identical to config.edn's leading bytes -- the same claim the
# 2026-08-29 traffic-scale close checked of its own three scale points.
# The LENGTH comes from the file, never from this script, so a future
# edit to either config changes the number here with no edit at all.
bare_bytes="$(stat -c%s demos/scenarios/dense-7500/config-bare.edn)"
prefix_bytes=$((bare_bytes - 2))
if [ "$(tail -c 2 demos/scenarios/dense-7500/config-bare.edn)" != "}" ]; then
  fail "additive prefix: config-bare.edn does not end in a closing brace and newline -- the prefix arithmetic below would be silently wrong"
fi
bare_prefix="$(head -c "$prefix_bytes" demos/scenarios/dense-7500/config-bare.edn | sha256sum | awk '{print $1}')"
full_prefix="$(head -c "$prefix_bytes" demos/scenarios/dense-7500/config.edn | sha256sum | awk '{print $1}')"
if [ "$bare_prefix" != "$full_prefix" ]; then
  fail "additive prefix: config-bare.edn's first $prefix_bytes bytes hash to $bare_prefix but config.edn's hash to $full_prefix -- the nine opt-in keys are no longer a pure append"
fi
echo "  additive prefix: config-bare.edn's own $prefix_bytes bytes ARE config.edn's prefix, sha256 $bare_prefix"

# THE GROUND-TRUTH PATH ACTUALLY PRODUCED A LOG. `--format ground-truth`
# writes the bare EDN vector to stdout, which step 3 redirected -- an
# empty or envelope-shaped file here would mean the flag silently fell
# back to the full envelope, which the exit code alone cannot see.
gt_file="out/scenarios/dense-7500-750.edn"
[ -s "$gt_file" ] || fail "ground-truth path: $gt_file is empty -- --format ground-truth wrote nothing"
if [ "$(head -c 1 "$gt_file")" != "[" ]; then
  fail "ground-truth path: $gt_file does not start with '[' -- --format ground-truth must write the bare top-level VECTOR, not the EDN envelope"
fi
echo "  ground-truth path: $gt_file is a bare top-level vector, $(stat -c%s "$gt_file") bytes"

echo "== demo-exerciser-dense-7500: checking the README's own witnessed figures =="

# THE WITNESSED COUNTS, RE-DERIVED FROM THE README AT RUNTIME rather
# than hand-copied here as bash literals -- bin/demo-exerciser-clinic-
# decade's own discipline, and for the same reason: a future
# re-witness edits the README and this check stays correct with no edit
# in this file. The claim read is the "What to look for" table's own
# `config.edn` rows, one per arrival count.
#
# A NOTE ON WHAT IS NOT CHECKED HERE. config-bare.edn has no row in
# that table and none is asserted: at 7,500 arrivals it stops with
# `:capacity-exhausted` before producing a corpus, which the README
# says in full. Asserting a figure it cannot produce would be a gate
# that can only ever be red.
readme_cells () {
  # $1 = the arrivals cell as the README writes it. Prints "<events> <messages>".
  grep -F "| \`config.edn\` | $1 |" demos/scenarios/dense-7500/README.md \
    | awk -F'|' '{gsub(/[ *,]/, "", $4); gsub(/[ *,]/, "", $5); print $4, $5}'
}

read -r want_events_7500 want_msgs_7500 <<< "$(readme_cells '7,500')"
read -r want_events_750 want_msgs_750 <<< "$(readme_cells '750')"
if [ -z "${want_events_7500:-}" ] || [ -z "${want_events_750:-}" ]; then
  fail "witnessed figures: could not read the README's own 'What to look for' table rows -- the check below would be vacuous"
fi

got_msgs="$(find out/scenarios/dense-7500 -maxdepth 1 -name 'msg-*.hl7' | wc -l | tr -d ' ')"
if [ "$got_msgs" -ne "$want_msgs_7500" ]; then
  fail "witnessed figures: the 7,500 cell spooled $got_msgs messages, the README witnesses $want_msgs_7500 -- seed 20260824 determinism did not reproduce"
fi
echo "  witnessed figures: $got_msgs spooled messages match the README's own re-derived claim"

# Both event counts in ONE JVM: parsing the 7,500 corpus's own log is
# the expensive half and there is no reason to pay startup twice.
WANT_EVENTS_7500="$want_events_7500" WANT_EVENTS_750="$want_events_750" \
clojure -M:dev:test -e '
(require (quote [clojure.edn :as edn]))
(let [check (fn [label path want]
              (let [got (count (edn/read-string (slurp path)))]
                (if (= got want)
                  (do (println (str "  witnessed figures: " label " holds " got " events, as the README witnesses")) true)
                  (do (println (str "FAIL: " label " holds " got " events, the README witnesses " want)) false))))
      a (check "the 7,500 corpus" "out/scenarios/dense-7500/events.edn"
               (Long/parseLong (System/getenv "WANT_EVENTS_7500")))
      b (check "the 750 ground-truth vector" "out/scenarios/dense-7500-750.edn"
               (Long/parseLong (System/getenv "WANT_EVENTS_750")))]
  (System/exit (if (and a b) 0 1)))
' || fail "witnessed event counts did not hold (see FAIL detail above)"

# Tree-clean postcondition (ADR-0005's own discipline, mirrored from
# bin/demo-exerciser-ed-tuesday): every write path above lands under
# the gitignored /out/ -- a full run must leave the tracked tree
# exactly as it found it.
dirty="$(git status --porcelain)"
if [ -n "$dirty" ]; then
  fail "tree not clean after a full run (ADR-0005 postcondition violated):
$dirty"
fi

echo "== demo-exerciser-dense-7500: every command asserted, every named derivation held, tree clean =="
