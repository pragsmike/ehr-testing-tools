#!/usr/bin/env bash
# Close-phase scaffold (R13, ADR-0122 "Both a." part (b); ADR-0127):
# generates the session-record + prompt-archive filename pair (R-A,
# build-session SKILL.md step 11) AND both directories' own README
# index lines -- the two-sided requirement
# `ehrt.docs-tooling.index-completeness-test` and
# `ehrt.docs-tooling.prompt-record-pairing-test` both gate -- instead
# of a session hand-remembering both edits (the index-completeness
# late catch `notes/adr/0126-*.md` named as its own second lesson,
# now anticipated here rather than rediscovered).
#
# Usage: bin/close-scaffold [--expect-tag NAME@SHA] <YYYY-MM-DD> <slug> <one-line description>
#
# Creates (only if missing -- an existing file is left untouched,
# never overwritten with a stub):
#   .agents/session-records/<date>-<slug>.md
#   .agents/prompts/<date>-<slug>.md
# and appends a star-bullet index line (only if not already present)
# to each directory's own README.md. Idempotent: safe to re-run with
# the same arguments. Touches nothing outside .agents/.
#
# --expect-tag NAME@SHA (ADR-0128, mechanical Step-0 receipts check):
# before scaffolding, verifies NAME resolves to an ANNOTATED tag at
# SHA both in this local clone and on remote origin (peeled ref) --
# the same check `bin/tag-ceremony --push` performs at payment time,
# re-run here as a receipt that the payment this session's own prompt
# licensed actually happened. Absent, un-annotated, or a different sha
# on either side prints a FINDING line and exits nonzero before any
# scaffolding runs. Omitting the flag leaves this script's behavior
# byte-identical to before this flag existed.
set -uo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)" || exit 2
cd -- "$repo_root" || exit 2

usage() {
  cat <<'EOF'
Usage: bin/close-scaffold [--expect-tag NAME@SHA] <YYYY-MM-DD> <slug> <one-line description>

Scaffolds .agents/session-records/<date>-<slug>.md and
.agents/prompts/<date>-<slug>.md (creating only whichever is missing),
plus a star-bullet README index line for each in their own
directory's README.md (added only if not already present). Idempotent:
safe to re-run with the same arguments. Touches nothing outside
.agents/.

--expect-tag NAME@SHA: verify NAME is an ANNOTATED tag at SHA, both
locally and on remote origin (peeled ref), before scaffolding. Fails
nonzero with a FINDING line if absent, un-annotated, or at a different
sha on either side. Omitted: behavior is unchanged.

Example:
  bin/close-scaffold 2026-08-13 ceremony-scripts "Ceremony scripts and sim-identity sweep"
  bin/close-scaffold --expect-tag stable-20260813-ceremony-scripts@a884967aa43cc1f4b7b8ba32524b470d3ce4e525 2026-08-13 ceremony-scripts "Ceremony scripts and sim-identity sweep"
EOF
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi

expect_tag=""
positional=()
while [ $# -gt 0 ]; do
  case "$1" in
    --expect-tag)
      expect_tag="${2:?--expect-tag requires a value (NAME@SHA)}"
      shift 2
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done
set -- "${positional[@]}"

if [ $# -lt 3 ]; then
  usage >&2
  exit 2
fi

date="$1"; slug="$2"; shift 2
description="$*"

# --- --expect-tag: mechanical Step-0 receipts check (ADR-0128) ----------
if [ -n "$expect_tag" ]; then
  expect_tag_name="${expect_tag%%@*}"
  expect_tag_sha="${expect_tag#*@}"
  if [ -z "$expect_tag_name" ] || [ -z "$expect_tag_sha" ] || [ "$expect_tag_name" = "$expect_tag" ]; then
    echo "FINDING: --expect-tag value '$expect_tag' does not match NAME@SHA" >&2
    exit 1
  fi

  if ! git rev-parse -q --verify "refs/tags/$expect_tag_name" >/dev/null; then
    echo "FINDING: --expect-tag '$expect_tag_name' not found locally -- Step 0 tag payment missing" >&2
    exit 1
  fi
  local_tag_type="$(git cat-file -t "refs/tags/$expect_tag_name" 2>/dev/null)"
  if [ "$local_tag_type" != "tag" ]; then
    echo "FINDING: --expect-tag '$expect_tag_name' exists locally but is not an ANNOTATED tag (type: $local_tag_type)" >&2
    exit 1
  fi
  local_tag_sha="$(git rev-list -n1 "$expect_tag_name")"
  if [ "$local_tag_sha" != "$expect_tag_sha" ]; then
    echo "FINDING: --expect-tag '$expect_tag_name' resolves locally to $local_tag_sha, expected $expect_tag_sha" >&2
    exit 1
  fi

  remote_tag_lines="$(git ls-remote --tags origin "refs/tags/$expect_tag_name" "refs/tags/$expect_tag_name^{}")"
  remote_tag_line_count="$(printf '%s\n' "$remote_tag_lines" | grep -c .)"
  if [ "$remote_tag_line_count" -eq 0 ]; then
    echo "FINDING: --expect-tag '$expect_tag_name' not found on remote origin" >&2
    exit 1
  fi
  if [ "$remote_tag_line_count" -lt 2 ]; then
    echo "FINDING: --expect-tag '$expect_tag_name' is un-annotated on remote origin (no peeled ref)" >&2
    exit 1
  fi
  remote_tag_sha="$(printf '%s\n' "$remote_tag_lines" | tail -1 | awk '{print $1}')"
  if [ "$remote_tag_sha" != "$expect_tag_sha" ]; then
    echo "FINDING: --expect-tag '$expect_tag_name' remote peeled ref is $remote_tag_sha, expected $expect_tag_sha" >&2
    exit 1
  fi

  echo "OK: --expect-tag '$expect_tag_name' verified locally and on remote at $expect_tag_sha"
fi

if ! [[ "$date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  echo "FAIL: date '$date' does not match YYYY-MM-DD" >&2
  exit 2
fi
if ! [[ "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "FAIL: slug '$slug' must be lowercase-kebab-case" >&2
  exit 2
fi
if [ -z "$description" ]; then
  echo "FAIL: a one-line description is required" >&2
  exit 2
fi

filename="${date}-${slug}.md"
record_path=".agents/session-records/${filename}"
prompt_path=".agents/prompts/${filename}"
record_readme=".agents/session-records/README.md"
prompt_readme=".agents/prompts/README.md"

create_stub() {
  local path="$1" kind="$2"
  if [ -f "$path" ]; then
    echo "SKIP: $path already exists, left untouched"
    return
  fi
  case "$kind" in
    record)
      printf '# %s -- %s\n\n(session record body TODO)\n' "$date" "$description" > "$path"
      ;;
    prompt)
      printf '# Archived prompt: %s (%s)\n\n(prompt text TODO)\n' "$slug" "$date" > "$path"
      ;;
  esac
  echo "CREATED: $path"
}

# The two index lines are no longer appended by hand (ADR-0147). Both
# directories' listings are GENERATED into a sibling INDEX.md by `make
# state-derived`, whose population is the directory itself -- so a
# scaffolded record cannot be missing from its index, rather than being
# present because this script remembered to add it. The READMEs the two
# variables above still name are convention prose now, capped at 40
# lines and asserted to carry no per-record row.
regenerate_indexes() {
  echo "Regenerating the two record indexes (make state-derived)..."
  if make state-derived; then
    echo "UPDATED: .agents/session-records/INDEX.md, .agents/prompts/INDEX.md"
  else
    echo "WARN: 'make state-derived' failed -- run it before committing, or" >&2
    echo "      ehrt.docs-tooling.state-derived-test and CI's freshness diff will be red." >&2
    return 1
  fi
}

create_stub "$record_path" record
create_stub "$prompt_path" prompt
regenerate_indexes || exit 1

echo "OK: ${filename} scaffolded in .agents/session-records/ and .agents/prompts/"
exit 0
