#!/usr/bin/env python3
"""Compression arc session D (notes/adr/0147-compression-arc-close.md).

Run ONCE, on 2026-08-17, to split `.agents/state.md` three ways:

  1. HISTORICAL -> `.agents/plans/state-history-2026-08.md`, VERBATIM.
     The file's whole 724-line prior text goes to the attic under a
     dated heading, together with the two record READMEs' own per-file
     row lists (223 + 171 lines, whose rows carried hand annotations
     the generated INDEX.md does not reproduce).
  2. DERIVABLE -> `.agents/state-derived.md`, GENERATED. Not this
     script's job: `make state-derived` renders it from the live tree
     (`ehrt.docs-tooling.state-derived`), and CI's own generated-doc
     freshness step diffs it.
  3. HAND-OWNED -> `.agents/state.md`, the residue this script writes:
     the register pointer table, what the repo is, the watch items
     carried nowhere else, the environment, and the design-channel
     contract. Capped at 120 lines by
     `ehrt.docs-tooling.state-residue-test`.

WHY THE WHOLE FILE MOVES VERBATIM rather than block-by-block. ADR-0145's
own migration keyed each `## From ...` block to a start line and a line
prefix, both asserted, because it was fanning thirty-odd blocks out to
thirty-odd different destination ADRs. Here there is ONE destination, so
the strongest available read-back is also the simplest: the entire prior
file, byte for byte, as one contiguous run of lines in the attic. A
block table would be a weaker instrument dressed as a stronger one --
it can only verify the blocks it was told about, and the census that
wrote it is exactly the thing that might be wrong. (It might well be:
this session's own census found the channel's pre-probe figures for
this file wrong in two places -- 13 dated preamble blocks against an
actual 11, and 9 `[V @b96c246]`-stamped sections against an actual 7.)

`--verify` asserts, against the tree as it stands NOW, that every moved
region is present at its destination as an exact contiguous block. That,
not `git diff --numstat`, is the instrument: ADR-0144 found a diffstat
cannot express a move of this shape as an identity, because git renders
moved lines that duplicate adjacent content as context rather than
insertions.

Usage:
    bin/state-migrate-0147 --dry-run   # what would be written, and sizes
    bin/state-migrate-0147             # do it
    bin/state-migrate-0147 --verify    # read every moved block back out
"""

import os
import subprocess
import sys

STATE = ".agents/state.md"
ATTIC = ".agents/plans/state-history-2026-08.md"
RECORDS_README = ".agents/session-records/README.md"
PROMPTS_README = ".agents/prompts/README.md"

BASE = "0b15e87"  # ADR-0146's close; the tree every figure below is keyed to

# The three regions that move, each identified by the marker line its
# extent starts at in the file AT BASE. `None` start means "the whole
# file". Every one is asserted present before anything is written.
MOVES = [
    {
        "src": STATE,
        "what": "the continuity register as it stood at 0b15e87",
        "start": None,           # whole file
        "end": None,
        "expect_lines": 724,
    },
    {
        "src": RECORDS_README,
        "what": "the session-record index rows, with their hand annotations",
        "start": "## Records",
        "end": None,             # to end of file
        "expect_lines": 153,
    },
    {
        "src": PROMPTS_README,
        "what": "the archived-prompt index rows, with their hand annotations",
        "start": "## Prompt list",
        "end": None,
        "expect_lines": 146,
    },
]


def read_lines(path):
    with open(path, encoding="utf-8") as fh:
        return fh.read().split("\n")


def at_base(path):
    """`path`'s content at BASE, as lines -- so --verify compares against
    what actually moved, not against a working tree that may have moved
    on since."""
    out = subprocess.run(["git", "show", f"{BASE}:{path}"],
                         capture_output=True, text=True, check=True)
    return out.stdout.split("\n")


def region(lines, start, end):
    """The lines of a move's own extent. A `start` of None is the whole
    file; an `end` of None runs to the last line. Trailing blank lines
    are dropped so a block's extent is unambiguous."""
    if start is None:
        block = list(lines)
    else:
        try:
            i = next(n for n, l in enumerate(lines) if l.startswith(start))
        except StopIteration:
            sys.exit(f"FATAL: {start!r} not found -- the tree has drifted from BASE {BASE}")
        j = len(lines)
        if end is not None:
            j = next((n for n, l in enumerate(lines[i + 1:], i + 1) if l.startswith(end)), len(lines))
        block = lines[i:j]
    while block and not block[-1].strip():
        block.pop()
    return block


def contiguous(haystack, needle):
    """True iff `needle` appears in `haystack` as an exact contiguous run
    of lines. This is the read-back instrument."""
    if not needle:
        return False
    n = len(needle)
    return any(haystack[i:i + n] == needle for i in range(len(haystack) - n + 1))


ATTIC_HEADER = """# Continuity-register history — 2026-08

**Moved here VERBATIM by `bin/state-migrate-0147`, 2026-08-17**
(compression arc session D, `notes/adr/0147-compression-arc-close.md`),
from `.agents/state.md` and the two dated record READMEs as they stood
at tip `0b15e87`. Nothing is summarised and nothing is deleted; this is
an attic, in the same sense as `roadmap-done-2026-08.md` and
`reading-sets-history.md`.

**Read this only for what was true on a given date.** For what is true
now: `.agents/state.md` holds the hand-owned half,
`.agents/state-derived.md` the derived half (regenerated on every `make
docsgen`), and `.agents/session-records/INDEX.md` /
`.agents/prompts/INDEX.md` the two record listings. This file is in no
reading set and is not maintained.

Why the move. `.agents/state.md` reached 724 lines the way registers in
this workspace reach any size: by appending. 340 of those lines were
eleven dated preamble blocks, each honest, each individually justified,
and each — from the ADR-0097 entry onward — saying in its own words that
the sections below it were stale. The regeneration contract those blocks
kept apologising to (`rulings.md#R-state-regeneration`) asks a session to
re-probe every claim by hand at each arc close; that was met once in
fifty ADRs. A claim re-derived by hand at each close is a claim that is
stale between closes, so the claims that a tree can derive are now
derived on every `make docsgen` instead, and what is left is small enough
to keep by hand.
"""


def build_attic():
    parts = [ATTIC_HEADER]
    for mv in MOVES:
        lines = at_base(mv["src"])
        block = region(lines, mv["start"], mv["end"])
        parts.append(
            f"\n---\n\n## From `{mv['src']}` — {mv['what']}\n\n"
            f"Verbatim at `{BASE}`, {len(block)} lines.\n\n"
            + "\n".join(block)
            + "\n"
        )
    return "".join(parts)


def check_expectations():
    """Every move's extent is the size the census recorded. A drifted
    tree fails loud here rather than writing a silently different block."""
    problems = []
    for mv in MOVES:
        n = len(region(at_base(mv["src"]), mv["start"], mv["end"]))
        if n != mv["expect_lines"]:
            problems.append(f"  {mv['src']} ({mv['start'] or 'whole file'}): "
                            f"expected {mv['expect_lines']} lines at {BASE}, found {n}")
    if problems:
        sys.exit("FATAL: extents do not match the census:\n" + "\n".join(problems))


def do_verify():
    if not os.path.exists(ATTIC):
        sys.exit(f"FAIL: {ATTIC} does not exist -- nothing has been migrated")
    attic = read_lines(ATTIC)
    failures = []
    for mv in MOVES:
        block = region(at_base(mv["src"]), mv["start"], mv["end"])
        if contiguous(attic, block):
            print(f"OK: {len(block):4d} lines from {mv['src']} "
                  f"({mv['start'] or 'whole file'}) found contiguous in {ATTIC}")
        else:
            failures.append(f"  {mv['src']} ({mv['start'] or 'whole file'}), {len(block)} lines")
    if failures:
        sys.exit("FAIL: block(s) NOT found contiguous at destination:\n" + "\n".join(failures))
    print(f"\nOK: all {len(MOVES)} moved regions read back byte-identical from {ATTIC}")


def main():
    if not os.path.isdir(".git"):
        sys.exit("FATAL: run from the workspace root")
    mode = sys.argv[1] if len(sys.argv) > 1 else ""

    if mode == "--verify":
        do_verify()
        return

    check_expectations()
    attic = build_attic()

    if mode == "--dry-run":
        print(f"would write {ATTIC}: {len(attic.split(chr(10)))} lines")
        for mv in MOVES:
            n = len(region(at_base(mv["src"]), mv["start"], mv["end"]))
            print(f"  <- {n:4d} lines from {mv['src']} ({mv['start'] or 'whole file'})")
        print("\nthe residue .agents/state.md and the two trimmed READMEs are AUTHORED,")
        print("not derived, and are written by hand in the same commit -- this script")
        print("moves history and proves the move, it does not write judgement.")
        return

    with open(ATTIC, "w", encoding="utf-8") as fh:
        fh.write(attic)
    print(f"wrote {ATTIC} ({len(attic.split(chr(10)))} lines)")
    print(f"now run: bin/state-migrate-0147 --verify")


if __name__ == "__main__":
    main()
