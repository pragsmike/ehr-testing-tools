{:top-namespace "ehrt"
 :interface-ns "interface"
 :default-profile-name "default"
 :dialects ["clj"]
 :compact-views #{}
 :vcs {:name "git"
       :auto-add false}
 :tag-patterns {:stable "^stable-.*"
                :release "^v[0-9].*"}
 :template-data {:clojure-ver "1.12.5"
                 :shadow-cljs-ver "^3.2.1"}
 :validations {:inconsistent-lib-versions {:type :error
                                           :exclude []}}
 :projects {"development" {:alias "dev"}
            "sim" {:alias "sim"}
            ;; :necessary overrides warning 207 (poly's own brick-graph
            ;; reachability check: is a declared brick reached by a real
            ;; :require edge from the project's base, or from another
            ;; brick the same project declares -- it does not see a
            ;; project's own ad hoc test-tree requires). Re-derived
            ;; 2026-07-31 (docs-tooling split, finding 14) via
            ;; `clojure -M:poly deps`/`check` with every entry temporarily
            ;; cleared, per brick, per project; re-derived AGAIN 2026-07-31
            ;; (corpus-io split stage 2, ADR-0017), same method, after
            ;; corpus-io joined all three projects. "ehrt-cli" needs no
            ;; override at all: bases/cli directly requires
            ;; ehrt.tools.interface, ehrt.corpus-io.interface, and
            ;; ehrt.docs-tooling.interface, and every other declared brick
            ;; (including palgebra) is real-edge-reachable transitively
            ;; through those three. "integration" ALSO needs no override
            ;; now (a change from the docs-tooling-split-era table, which
            ;; had `tools` here): with :necessary [] on this project,
            ;; `poly check` reports zero warnings -- confirmed empirically,
            ;; not just carried forward from the prior table.
            "ehrt-cli" {:alias "ehrt-cli"}
            "conformance" {:alias "conformance"
                           :necessary ["docs-tooling"]}
            "integration" {:alias "integration"}}}
