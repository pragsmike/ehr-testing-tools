{:top-namespace "ehrt"
 :interface-ns "interface"
 :default-profile-name "default"
 :dialects ["clj"]
 :compact-views #{}
 :vcs {:name "git"
       :auto-add false}
 :tag-patterns {:stable "^stable-.*"
                :release "^v[0-9].*"}
 :template-data {:clojure-ver "1.12.5"
                 :shadow-cljs-ver "^3.2.1"}
 :validations {:inconsistent-lib-versions {:type :error
                                           :exclude []}}
 :projects {"development" {:alias "dev"}
            "sim" {:alias "sim"}
            ;; :necessary overrides warning 207 (poly's brick-necessity
            ;; check is one-hop from a *base*; palgebra/tools are real,
            ;; confirmed component-to-component/test-to-interface
            ;; dependencies it doesn't trace transitively -- notes/ADRs.md
            ;; ADR-0002).
            "tools-cli" {:alias "tools-cli"
                         :necessary ["palgebra"]}
            "conformance" {:alias "conformance"
                           :necessary ["tools" "palgebra"]}
            "integration" {:alias "integration"
                           :necessary ["tools" "palgebra"]}}}
