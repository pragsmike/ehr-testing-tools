  {:patient-ordinal 45 :module-id "sinusitis"}
  {:patient-ordinal 46 :module-id "sinusitis"}
  {:patient-ordinal 47 :module-id "sinusitis"}
  {:patient-ordinal 48 :module-id "sinusitis"}
  {:patient-ordinal 49 :module-id "sinusitis"}
  {:patient-ordinal 50 :module-id "sinusitis"}
