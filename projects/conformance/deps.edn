{:deps {;; No poly/sim entry -- ADR-0013 (notes/tools/ADRs.md, carried
        ;; forward as provenance): sim is consumed by subprocess only,
        ;; never a classpath/deps.edn dependency, even from this test
        ;; loop. sim_harness.clj shells out to the sim CLI directly.
        poly/tools    {:local/root "../../components/tools"}
        poly/palgebra {:local/root "../../components/palgebra"}
        org.clojure/clojure {:mvn/version "1.12.5"}}

 :aliases {;; Base-less project (R15): sim + tools + palgebra, test-only.
           ;; This project's own "test" dir (was ehr-testing-tools'
           ;; test-integration/) is where the actual test files live,
           ;; unlike a base-having project's near-empty :test alias.
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               org.clojure/test.check {:mvn/version "1.1.3"}}
                  :exec-fn cognitect.test-runner.api/test
                  :exec-args {:dirs ["test"]}}}}
