{:deps {;; poly/sim: ADR-0013's subprocess-only rule is superseded
        ;; (ADR-0004, 2026-07-28) -- ehrt.tools.sim now calls
        ;; ehrt.sim.interface/run-command in-process, so this project's
        ;; sim_harness.clj and its five sim_*_test.clj consumers need
        ;; sim on the classpath like any other component this project
        ;; exercises. See ADR-0004 for why the ADR-0013-era reasons
        ;; (private-repo split, cross-repo version lockstep) no longer
        ;; hold.
        ;; poly/kernel, poly/judge (ADR-0008): tools' own src requires
        ;; both directly now.
        poly/kernel   {:local/root "../../components/kernel"}
        poly/judge    {:local/root "../../components/judge"}
        poly/tools    {:local/root "../../components/tools"}
        poly/palgebra {:local/root "../../components/palgebra"}
        poly/sim      {:local/root "../../components/sim"}
        org.clojure/clojure {:mvn/version "1.12.5"}}

 :aliases {;; Base-less project (R15): sim + tools + palgebra, test-only.
           ;; This project's own "test" dir (was ehr-testing-tools'
           ;; test-integration/) is where the actual test files live,
           ;; unlike a base-having project's near-empty :test alias.
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               org.clojure/test.check {:mvn/version "1.1.3"}}
                  :exec-fn cognitect.test-runner.api/test
                  :exec-args {:dirs ["test"]}}}}
