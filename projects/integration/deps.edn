{;; NIST v2-validation engine (judge-v2-nist, ADR-0012): its three
 ;; gov.nist coordinates resolve from NIST's own Nexus, not Maven
 ;; Central. Root deps.edn's own :mvn/repos isn't inherited here --
 ;; `poly test :all` resolves each project's own deps.edn
 ;; independently, so this repeats the same entry.
 :mvn/repos {"nist-hit" {:url "https://hit-nexus.nist.gov/repository/releases/"}}

 :deps {;; poly/sim: not because this project's own tests reference
        ;; ehrt.sim.* directly (they don't -- ADR-0004's own R19
        ;; disposition is why the five sim_*_test.clj namespaces stayed
        ;; in projects/conformance instead of moving here), but because
        ;; poly/tools' own src now requires ehrt.sim.interface
        ;; transitively (ADR-0005, the ehr-sim-mount) -- any project
        ;; that includes poly/tools needs sim on the classpath now.
        ;; poly/kernel, poly/judge (ADR-0008): poly/tools' own src
        ;; requires both directly now -- any project including
        ;; poly/tools needs them on the classpath too.
        poly/kernel   {:local/root "../../components/kernel"}
        poly/judge    {:local/root "../../components/judge"}
        ;; poly/judge-v2-hapi, poly/judge-fhir-official (ADR-0011): the
        ;; per-engine judge split -- ehrt.tools.interface now requires
        ;; both directly too.
        poly/judge-v2-hapi        {:local/root "../../components/judge-v2-hapi"}
        poly/judge-fhir-official  {:local/root "../../components/judge-fhir-official"}
        ;; poly/judge-v2-nist (ADR-0012): the third judge engine,
        ;; profile-tier NIST v2-validation -- ehrt.tools.interface now
        ;; requires it too.
        poly/judge-v2-nist        {:local/root "../../components/judge-v2-nist"}
        poly/tools    {:local/root "../../components/tools"}
        ;; poly/corpus-io (2026-07-31, corpus-io split stage 2,
        ;; ADR-0017): poly/tools' own src now requires it directly
        ;; (transport seam), and this project's own
        ;; zero_flag_reproducibility_test.clj requires it directly too
        ;; (canonicalizers, repointed from ehrt.tools.interface).
        poly/corpus-io {:local/root "../../components/corpus-io"}
        ;; poly/palgebra DROPPED here (2026-07-31, docs-tooling split,
        ;; finding 14 re-derivation): tools' own src no longer requires
        ;; palgebra at all (that edge moved to docs-tooling, which this
        ;; project deliberately does not include -- AR-3 places
        ;; docs-tooling's own tests in conformance only). Confirmed by
        ;; grep: no file under this project's own test/ requires
        ;; ehrt.palgebra either. If a future change reintroduces a real
        ;; need, re-add it then, with its own earning edge named.
        poly/sim      {:local/root "../../components/sim"}
        org.clojure/clojure {:mvn/version "1.12.5"}}

 :aliases {;; Base-less project (R19, ADR-0004): the artifact-fetch-
           ;; dependent half of what used to be one undifferentiated
           ;; projects/conformance/test tree. Every namespace under this
           ;; project's own "test" requires `ehr artifact fetch` for
           ;; synthea/temurin-jdk/fhir-validator-cli to have already run --
           ;; ENF-1's two-lane rule (notes/tools/prompts/2026-07-25-enf1-
           ;; enforcement-wave.md), restored: this lane is scheduled +
           ;; workflow_dispatch only (.github/workflows/integration.yml),
           ;; never per-push.
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               org.clojure/test.check {:mvn/version "1.1.3"}}
                  :exec-fn cognitect.test-runner.api/test
                  :exec-args {:dirs ["test"]}}}}
