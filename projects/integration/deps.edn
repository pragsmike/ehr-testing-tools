{:deps {;; poly/sim: not because this project's own tests reference
        ;; ehrt.sim.* directly (they don't -- ADR-0004's own R19
        ;; disposition is why the five sim_*_test.clj namespaces stayed
        ;; in projects/conformance instead of moving here), but because
        ;; poly/corpus' own src now requires ehrt.sim.interface
        ;; transitively (ADR-0005, the ehr-sim-mount) -- any project
        ;; that includes poly/corpus needs sim on the classpath now.
        ;; poly/kernel, poly/judge (ADR-0008): poly/corpus' own src
        ;; requires both directly now -- any project including
        ;; poly/corpus needs them on the classpath too. sim's own src
        ;; requires kernel directly too (ADR-0022, 2026-08-01).
        poly/kernel   {:local/root "../../components/kernel"}
        poly/judge    {:local/root "../../components/judge"}
        ;; poly/judge-fhir-official (ADR-0011): required directly by
        ;; this project's own test tree (baseline_gating/
        ;; contract_pairing/smoke gate through the official validator).
        ;; poly/judge-v2-hapi stays for a different reason (ADR-0018):
        ;; the corpus BRICK's own test tree (v2_contract_pairing_test)
        ;; requires that engine's interface, and poly runs a declared
        ;; brick's tests in every composing project -- dropping it here
        ;; broke this lane's own run before commit, not a hypothetical.
        ;; poly/judge-v2-nist DROPPED here (2026-07-31, split stage 3,
        ;; ADR-0018, same rule as palgebra's drop below): it was only
        ;; ever here because the retired ehrt.tools.interface required
        ;; every engine; grep confirms nothing on this project's
        ;; classpath requires it. The nist-hit :mvn/repos entry left
        ;; with it. If a future change reintroduces a real need,
        ;; re-add then, with its own earning edge named.
        poly/judge-v2-hapi        {:local/root "../../components/judge-v2-hapi"}
        poly/judge-fhir-official  {:local/root "../../components/judge-fhir-official"}
        ;; poly/provenance (sim split B, M1, 2026-08-04): poly/corpus'
        ;; own src now requires ehrt.provenance.interface directly --
        ;; any project including poly/corpus needs it on the classpath.
        poly/provenance {:local/root "../../components/provenance"}
        poly/corpus   {:local/root "../../components/corpus"}
        ;; poly/corpus-io (2026-07-31, corpus-io split stage 2,
        ;; ADR-0017): poly/corpus' own src now requires it directly
        ;; (transport seam), and this project's own
        ;; zero_flag_reproducibility_test.clj requires it directly too
        ;; (canonicalizers, repointed from ehrt.tools.interface).
        poly/corpus-io {:local/root "../../components/corpus-io"}
        ;; poly/palgebra DROPPED here (2026-07-31, docs-tooling split,
        ;; finding 14 re-derivation): tools' own src no longer requires
        ;; palgebra at all (that edge moved to docs-tooling, which this
        ;; project deliberately does not include -- AR-3 places
        ;; docs-tooling's own tests in conformance only). Confirmed by
        ;; grep: no file under this project's own test/ requires
        ;; ehrt.palgebra either. If a future change reintroduces a real
        ;; need, re-add it then, with its own earning edge named.
        poly/sim      {:local/root "../../components/sim"}
        ;; poly/sim-model (sim split S1, .agents/plans/2026-08-02-sim-
        ;; split-plan.md): poly/sim's own src now requires
        ;; ehrt.sim-model.interface transitively.
        poly/sim-model {:local/root "../../components/sim-model"}
        ;; poly/sim-trajectory (sim split S2): poly/sim's own src now
        ;; requires ehrt.sim-trajectory.interface transitively.
        poly/sim-trajectory {:local/root "../../components/sim-trajectory"}
        ;; poly/sim-emit-hl7 (sim split S3 / Wave D stage D0): poly/sim's
        ;; own src now requires ehrt.sim-emit-hl7.interface transitively.
        poly/sim-emit-hl7 {:local/root "../../components/sim-emit-hl7"}
        org.clojure/clojure {:mvn/version "1.12.5"}}

 :aliases {;; Base-less project (R19, ADR-0004): the artifact-fetch-
           ;; dependent half of what used to be one undifferentiated
           ;; projects/conformance/test tree. Every namespace under this
           ;; project's own "test" requires `ehr artifact fetch` for
           ;; synthea/temurin-jdk/fhir-validator-cli to have already run --
           ;; ENF-1's two-lane rule (notes/tools/prompts/2026-07-25-enf1-
           ;; enforcement-wave.md), restored: this lane is scheduled +
           ;; workflow_dispatch only (.github/workflows/integration.yml),
           ;; never per-push.
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               org.clojure/test.check {:mvn/version "1.1.3"}}
                  :exec-fn cognitect.test-runner.api/test
                  :exec-args {:dirs ["test"]}}}}
