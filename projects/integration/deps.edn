{:deps {;; poly/sim: not because this project's own tests reference
        ;; ehrt.sim.* directly (they don't -- ADR-0004's own R19
        ;; disposition is why the five sim_*_test.clj namespaces stayed
        ;; in projects/conformance instead of moving here), but because
        ;; poly/tools' own src now requires ehrt.sim.interface
        ;; transitively (ADR-0005, the ehr-sim-mount) -- any project
        ;; that includes poly/tools needs sim on the classpath now.
        ;; poly/kernel, poly/judge (ADR-0008): poly/tools' own src
        ;; requires both directly now -- any project including
        ;; poly/tools needs them on the classpath too.
        poly/kernel   {:local/root "../../components/kernel"}
        poly/judge    {:local/root "../../components/judge"}
        poly/tools    {:local/root "../../components/tools"}
        poly/palgebra {:local/root "../../components/palgebra"}
        poly/sim      {:local/root "../../components/sim"}
        org.clojure/clojure {:mvn/version "1.12.5"}}

 :aliases {;; Base-less project (R19, ADR-0004): the artifact-fetch-
           ;; dependent half of what used to be one undifferentiated
           ;; projects/conformance/test tree. Every namespace under this
           ;; project's own "test" requires `ehr artifact fetch` for
           ;; synthea/temurin-jdk/fhir-validator-cli to have already run --
           ;; ENF-1's two-lane rule (notes/tools/prompts/2026-07-25-enf1-
           ;; enforcement-wave.md), restored: this lane is scheduled +
           ;; workflow_dispatch only (.github/workflows/integration.yml),
           ;; never per-push.
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               org.clojure/test.check {:mvn/version "1.1.3"}}
                  :exec-fn cognitect.test-runner.api/test
                  :exec-args {:dirs ["test"]}}}}
