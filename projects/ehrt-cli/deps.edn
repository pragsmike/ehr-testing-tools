{;; NIST v2-validation engine (judge-v2-nist, ADR-0012): its three
 ;; gov.nist coordinates resolve from NIST's own Nexus, not Maven
 ;; Central. Root deps.edn's own :mvn/repos isn't inherited here --
 ;; `poly test :all` resolves each project's own deps.edn
 ;; independently, so this repeats the same entry.
 :mvn/repos {"nist-hit" {:url "https://hit-nexus.nist.gov/repository/releases/"}}

 :deps {;; poly/kernel, poly/judge (ADR-0008): tools' own src requires
        ;; both directly now (result/digest/artifact/canonical/locator/
        ;; invocation, judge's five namespaces).
        poly/kernel   {:local/root "../../components/kernel"}
        poly/judge    {:local/root "../../components/judge"}
        ;; poly/judge-v2-hapi, poly/judge-fhir-official (ADR-0011): the
        ;; per-engine judge split -- ehrt.tools.interface now requires
        ;; both directly too.
        poly/judge-v2-hapi        {:local/root "../../components/judge-v2-hapi"}
        poly/judge-fhir-official  {:local/root "../../components/judge-fhir-official"}
        ;; poly/judge-v2-nist (ADR-0012): the third judge engine,
        ;; profile-tier NIST v2-validation -- ehrt.tools.interface now
        ;; requires it too.
        poly/judge-v2-nist        {:local/root "../../components/judge-v2-nist"}
        poly/tools    {:local/root "../../components/tools"}
        poly/palgebra {:local/root "../../components/palgebra"}
        poly/cli      {:local/root "../../bases/cli"}
        ;; poly/sim: the `ehrt sim` mount (ADR-0004, tools/ADR-0012 fulfilled)
        ;; -- ehrt.tools.sim calls ehrt.sim.interface/run-command
        ;; in-process, no subprocess. Real dependency, not test-only.
        poly/sim      {:local/root "../../components/sim"}
        org.clojure/clojure {:mvn/version "1.12.5"}}

 :aliases {:test {:extra-paths []
                   :extra-deps  {}}

           ;; Not the real `ehrt` entry point -- see root deps.edn's own
           ;; :ehrt alias and bin/ehrt. ehrt.tools.* reads
           ;; artifacts.lock.edn/config/*/components/tools/test-fixtures/** as
           ;; cwd-relative literal paths (ADR-0005, not classpath
           ;; resources), so those only resolve when cwd is the
           ;; workspace root -- invoking :run from *this* directory
           ;; needs those files copied here first. Kept for parity with
           ;; every other project's own :run alias, not as the
           ;; supported invocation path.
           :run {:main-opts ["-m" "ehrt.cli.core"]}

           ;; Ported from ehr-testing-tools' own :coverage alias
           ;; (ADR-0006 posture: measure and report; the 85%
           ;; --fail-threshold did not carry forward -- see
           ;; notes/ADRs.md ADR-0002 for why).
           :coverage {:extra-paths ["../../components/kernel/test"
                                     "../../components/judge/test"
                                     "../../components/judge-v2-hapi/test"
                                     "../../components/judge-fhir-official/test"
                                     "../../components/judge-v2-nist/test"
                                     "../../components/tools/test"
                                     "../../components/palgebra/test"
                                     "../../bases/cli/test"]
                      :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}
                                   org.clojure/test.check {:mvn/version "1.1.3"}
                                   org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
                      :main-opts ["-m" "cloverage.coverage"
                                  "-p" "../../components/kernel/src"
                                  "-p" "../../components/judge/src"
                                  "-p" "../../components/judge-v2-hapi/src"
                                  "-p" "../../components/judge-fhir-official/src"
                                  "-p" "../../components/judge-v2-nist/src"
                                  "-p" "../../components/tools/src"
                                  "-p" "../../components/palgebra/src"
                                  "-p" "../../bases/cli/src"
                                  "-s" "../../components/kernel/test"
                                  "-s" "../../components/judge/test"
                                  "-s" "../../components/judge-v2-hapi/test"
                                  "-s" "../../components/judge-fhir-official/test"
                                  "-s" "../../components/judge-v2-nist/test"
                                  "-s" "../../components/tools/test"
                                  "-s" "../../components/palgebra/test"
                                  "-s" "../../bases/cli/test"]}}}
