{:deps {poly/sim     {:local/root "../../components/sim"}
        poly/sim-cli {:local/root "../../bases/sim-cli"}
        org.clojure/clojure {:mvn/version "1.12.3"}}

 :aliases {:test {:extra-paths []
                  :extra-deps  {}}
           :run  {:main-opts ["-m" "ehrt.sim-cli.core"]}

           ;; Ported from ehr-testing-sim's own :coverage alias (ADR-0004
           ;; posture: measure and report, no --fail-threshold -- this repo
           ;; has no coverage baseline to ratchet against yet).
           :coverage {:extra-paths ["../../components/sim/test"
                                     "../../bases/sim-cli/test"]
                      :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}
                                   org.clojure/test.check {:mvn/version "1.1.3"}
                                   org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
                      :main-opts ["-m" "cloverage.coverage"
                                  "-p" "../../components/sim/src"
                                  "-p" "../../bases/sim-cli/src"
                                  "-s" "../../components/sim/test"
                                  "-s" "../../bases/sim-cli/test"]}}}
