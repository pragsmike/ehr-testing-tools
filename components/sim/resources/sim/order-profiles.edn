;; Order profiles catalytic (docs/sim-theory.edn's `order-profiles`,
;; target 3 -- hashed repo-authored config, docs/sim-theory.md's
;; Catalytic resolution table). A small, hand-curated starter set: CBC
;; and BMP panels, real LOINC codes (verified directly against
;; loinc.org 2026-07-26 -- see notes/facts-register.md), US
;; conventional units, typical adult reference ranges (representative
;; clinical ranges, not tied to one lab's exact methodology -- this
;; project's realism goal is plausibility, not diagnostic precision),
;; and a per-analyte value distribution (normal + abnormal tails).
;;
;; Concepts are {:system :loinc :code :display} triplets per ADR-0002's
;; code-provenance law. NO CPT anywhere (docs/third-party-sources.md's
;; standing constraint). Turnaround is authored in MINUTES
;; (docs/patient-state-model.md's durations rule); the engine converts
;; to seconds at decide-time, the same treatment :delay's IR already
;; gets.
;;
;; Each analyte's :distribution is a 3-way categorical draw
;; (:normal/:low/:high weights) then a uniform sample within whichever
;; range is chosen -- ehrt.sim.order-profiles/sample-analyte-value
;; is the sampler this data feeds. :precision is decimal places for
;; rendering (matching typical lab-report precision per analyte).
{:cbc
 {:concept {:system :loinc :code "58410-2" :display "CBC panel - Blood by Automated count"}
  :turnaround-minutes {:from 30 :to 90}
  :analytes
  [{:concept {:system :loinc :code "6690-2" :display "Leukocytes [#/volume] in Blood by Automated count"}
    :units "K/uL" :precision 1
    :reference-range {:low 4.5 :high 11.0}
    :distribution {:weights {:normal 0.85 :low 0.075 :high 0.075}
                   :abnormal-low-range {:low 2.0 :high 4.5}
                   :abnormal-high-range {:low 11.0 :high 25.0}}}
   {:concept {:system :loinc :code "789-8" :display "Erythrocytes [#/volume] in Blood by Automated count"}
    :units "M/uL" :precision 2
    :reference-range {:low 4.2 :high 5.9}
    :distribution {:weights {:normal 0.85 :low 0.075 :high 0.075}
                   :abnormal-low-range {:low 3.0 :high 4.2}
                   :abnormal-high-range {:low 5.9 :high 7.0}}}
   {:concept {:system :loinc :code "718-7" :display "Hemoglobin [Mass/volume] in Blood"}
    :units "g/dL" :precision 1
    :reference-range {:low 12.0 :high 17.5}
    :distribution {:weights {:normal 0.85 :low 0.075 :high 0.075}
                   :abnormal-low-range {:low 7.0 :high 12.0}
                   :abnormal-high-range {:low 17.5 :high 20.0}}}
   {:concept {:system :loinc :code "4544-3" :display "Hematocrit [Volume Fraction] of Blood by Automated count"}
    :units "%" :precision 1
    :reference-range {:low 36.0 :high 50.0}
    :distribution {:weights {:normal 0.85 :low 0.075 :high 0.075}
                   :abnormal-low-range {:low 20.0 :high 36.0}
                   :abnormal-high-range {:low 50.0 :high 60.0}}}
   {:concept {:system :loinc :code "777-3" :display "Platelets [#/volume] in Blood by Automated count"}
    :units "K/uL" :precision 0
    :reference-range {:low 150 :high 450}
    :distribution {:weights {:normal 0.85 :low 0.075 :high 0.075}
                   :abnormal-low-range {:low 20 :high 150}
                   :abnormal-high-range {:low 450 :high 900}}}]}

