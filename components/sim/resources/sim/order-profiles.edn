   {:concept {:system :loinc :code "2069-3" :display "Chloride [Moles/volume] in Blood"}
    :units "mmol/L" :precision 0
    :reference-range {:low 96 :high 106}
    :distribution {:weights {:normal 0.85 :low 0.075 :high 0.075}
