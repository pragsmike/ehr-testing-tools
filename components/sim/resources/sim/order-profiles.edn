   {:concept {:system :loinc :code "20565-8" :display "Carbon dioxide, total [Moles/volume] in Blood"}
    :units "mmol/L" :precision 0
    :reference-range {:low 23 :high 29}
    :distribution {:weights {:normal 0.85 :low 0.075 :high 0.075}
                   :abnormal-low-range {:low 10 :high 23}
                   :abnormal-high-range {:low 29 :high 40}}}]}}
