  :judge :judge-v2-hapi
  :locator "MSH-9"
  :expected #{"hl7-exception"}
  :fixture "components/corpus/test-fixtures/v2/adt-a01-admit.hl7"
  :witness {:adr "0088" :date "2026-08-08"}}

