;; Exercised-sources register (ADR-0129, dimension-1 fix design Q1(a)/
;; Q3(a)): one row per {doc-taught-strip, exercising bin/ script} pair
;; this workspace actually re-runs, verbatim, against the live tree --
;; the mechanism the manual-review skill's own first run (dimension 1,
;; `.agents/plans/2026-08-13-manual-review-1.md`) found missing for a
;; `docs/use-cases/*.md` page or README's own "What you get" fence.
;; Read/validated by `ehrt.docs-tooling.exercised-sources`; consumed by
;; `ehrt.docs-tooling.strip-fresh`'s generalized freshness check and by
;; the citation gate (`ehrt.docs-tooling.citation-gate-test`, commit 4)
;; that requires every `docs/manual/0*.md` "Strip source citations"
;; table entry to resolve to a row here.
;;
;; :extraction is one of:
;;   :quickstart-fresh      -- delegates to ehrt.docs-tooling.quickstart-fresh
;;                              verbatim (the pre-existing pair, unmodified).
;;   :demo-exerciser-fresh  -- delegates to ehrt.docs-tooling.demo-exerciser-fresh,
;;                              passing this row's own :marker-open/:marker-close
;;                              through (ADR-0130 widened the pre-existing
;;                              ed-tuesday-only pair to an explicit param, defaulted
;;                              to ed-tuesday's own literal markers, so a FUTURE
;;                              second :demo-exerciser-fresh row can supply its
;;                              own, honestly-named markers -- ADR-0130 landed
;;                              this widening but deferred its own motivating
;;                              row, clinic-decade, on a real, unrelated
;;                              defect found live; see roadmap.md).
;;   :single-fence          -- one ```<fence-lang> fence in :source, comment
;;                              and blank lines stripped, everything else kept
;;                              verbatim (quickstart-fresh's own algorithm,
;;                              generalized to an arbitrary source/script pair
;;                              rather than reimplemented against quickstart-
;;                              fresh's own private fns).
;;   :paired                -- every ```<fence-lang> fence in :source that is
;;                              immediately followed (blank lines only, no
;;                              intervening prose) by a fence of a DIFFERENT
;;                              language yields a (command-lines, output-lines)
;;                              pair; a same-language source with no such
;;                              pairing anywhere contributes nothing (this
;;                              register's own :paired row targets exactly
;;                              README.md's "What you get" section, which is
;;                              the only place in that file the pairing
;;                              pattern occurs -- README's "See it run" ```bash
;;                              fence is followed by prose, not an output
;;                              fence, so it is correctly excluded by the
;;                              adjacency rule alone, no section-heading logic
;;                              needed).
;;
;; :env is a possibly-empty map of environment-variable bindings the
;; exercising script sets before running the source's own taught
;; commands (ADR-0129 Q2(a): env-var placeholders are the sanctioned
;; strip parameterization). Empty for every row whose source needs no
;; substitution.
;;
;; :section (optional) disambiguates a :source with MORE THAN ONE row
;; -- README.md alone, whose Quickstart fence and "What you get"
;; section are two unrelated citable sections, each its own row. The
;; citation gate's own coverage check only requires a section match
;; when a :source has multiple rows (README.md's own two); every
;; other :source here has exactly one row, so its own :section, if
;; present, is documentation only, never load-bearing for coverage.

[{:source "README.md"
  :script "bin/quickstart-demo"
  :extraction :quickstart-fresh
  :section "Quickstart"
  :marker-open "# BEGIN quickstart commands (verbatim from README.md's Quickstart fence)"
  :marker-close "# END quickstart commands"
  :env {}
  :witness {:adr "ADR-0004" :date "2026-07-26"}}

 {:source "demos/scenarios/ed-tuesday/README.md"
  :script "bin/demo-exerciser-ed-tuesday"
  :extraction :demo-exerciser-fresh
  :marker-open "# BEGIN ed-tuesday commands (verbatim from demos/scenarios/ed-tuesday/README.md)"
  :marker-close "# END ed-tuesday commands"
  :env {}
  :witness {:adr "ADR-0120" :date "2026-08-12"}}

 {:source "docs/use-cases/judge-tier-calibration-studies.md"
