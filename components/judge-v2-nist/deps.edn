{:paths ["src"]

 ;; NIST v2-validation engine (profile-tier HL7 v2 judge). These
 ;; coordinates resolve from NIST's own Nexus, NOT Maven Central --
 ;; add to the ROOT deps.edn (:mvn/repos is only honored at the root):
 ;;
 ;;   :mvn/repos {"nist-hit" {:url "https://hit-nexus.nist.gov/repository/releases/"}}
 ;;
 ;; Determinism note (artifacts.lock.edn discipline): after first
 ;; resolution, record the jar sha256s; hit-nexus has no stated
 ;; availability SLA and just changed operators (NIST -> Prometheus
 ;; Computing, Aug 2026 transition), so vendoring the six resolved jars
 ;; into a file:// repo mirror is the safe end-state. CDC does exactly
 ;; this in gov.cdc:lib-hl7v2-nist-validator (lib/ as file:// repo).
 ;;
 ;; Transitive deps beyond these three (scala-library 2.13.10, typesafe
 ;; config 1.4.2, commons-lang3, xom 1.3.7, scala-xml_2.13 1.3.0,
 ;; jackson, httpclient 4.5.9) DO resolve from Maven Central normally.
 :deps {gov.nist/hl7-v2-validation {:mvn/version "1.7.3"}
        gov.nist/hl7-v2-parser     {:mvn/version "1.7.3"}
        gov.nist/hl7-v2-profile    {:mvn/version "1.7.3"}}

 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                               org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}}}}
