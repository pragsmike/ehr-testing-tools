{:paths ["src" "resources"]

 :deps {metosin/malli {:mvn/version "0.20.1"}
        ;; sim-model (ADR-0172 section 2, "Dependency direction"): the
        ;; `Persona` shape, the payer pools and the `places.edn` pool
        ;; a residence move draws from. This component REUSES the
        ;; persona construction rather than forking it.
        poly/sim-model {:local/root "../sim-model"}
        ;; sim-engine, for the stream-partition surface ALONE --
        ;; `stream` and `newborn-id-tag` (ADR-0171 section 2(b)/(c)).
        ;; Limitations row 10 gates the "alone": this component's `ns`
        ;; forms may name no other `sim-engine` namespace, and no
        ;; `sim-engine` namespace may require this component in v1.
        poly/sim-engine {:local/root "../sim-engine"}}

 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                               org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}}}}
