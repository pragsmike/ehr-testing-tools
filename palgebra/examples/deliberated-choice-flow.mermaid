flowchart LR

    %% --- Source types (raw inputs, not produced by any operation) ---
    character_propensities(["character-propensities"])
    coverage_criteria(["coverage-criteria"])
    evaluation_rubrics(["evaluation-rubrics"])
    raw_problem(["raw-problem"])
    remediation_threshold(["remediation-threshold"])
    roberts_rules(["roberts-rules"])
    scenario_parameters(["scenario-parameters"])
    scenario_roster(["scenario-roster"])
    scenario_rubric(["scenario-rubric"])

    %% --- Operations (boxes; spiders use distinct shapes) ---
    FrameSituation["FrameSituation"]
    Fan[/"Fan"\]
    AssessScenarios["AssessScenarios"]
    CoverageGate["CoverageGate"]
    DraftCharter["DraftCharter"]
    Convene["Convene"]
    Deliberate[\"Deliberate"/]
    Resolve["Resolve"]
    Evaluate["Evaluate"]
    QualityGate["QualityGate"]
    Remediate["Remediate"]
    ReEvaluate["ReEvaluate"]
    HumanGate["HumanGate"]

    %% --- Waste / discard sinks ---
    gaps_identified_sink(["gaps-identified"])
    rejected_resolution_sink(["rejected-resolution"])

    %% --- Wires (typed connections) ---
    %% Arrow 14: FrameSituation
    raw_problem -- raw-problem --> FrameSituation

    %% Arrow 19: Fan
    FrameSituation -- situation --> Fan
    scenario_roster -. scenario-roster .-> Fan
    scenario_parameters -. scenario-parameters .-> Fan

    %% Arrow 23: AssessScenarios
    Fan -- scenario-set --> AssessScenarios
    scenario_rubric -. scenario-rubric .-> AssessScenarios

    %% Arrow 27: CoverageGate
    Fan -- scenario-set --> CoverageGate
    coverage_criteria -. coverage-criteria .-> CoverageGate
    CoverageGate -- "gaps-identified" --> gaps_identified_sink

    %% Arrow 33: DraftCharter
    CoverageGate -- adequate-set --> DraftCharter

    %% Arrow 40: Convene
    DraftCharter -. charter .-> Convene
    character_propensities -. character-propensities .-> Convene

    %% Arrow 45: Deliberate
    DraftCharter -. charter .-> Deliberate
    Convene -- roster --> Deliberate
    Convene -- convening --> Deliberate
    CoverageGate -- adequate-set --> Deliberate
    character_propensities -. character-propensities .-> Deliberate
    roberts_rules -. roberts-rules .-> Deliberate

    %% Arrow 48: Resolve
    Remediate -- transcript --> Resolve
    DraftCharter -. charter .-> Resolve

    %% Arrow 56: Evaluate
    Remediate -- transcript --> Evaluate
    evaluation_rubrics -. evaluation-rubrics .-> Evaluate
    DraftCharter -. charter .-> Evaluate

    %% Arrow 60: QualityGate
    ReEvaluate -- evaluation --> QualityGate
    remediation_threshold -. remediation-threshold .-> QualityGate

    %% Arrow 64: Remediate
    QualityGate -- needs-remediation --> Remediate
    Remediate -- transcript --> Remediate
    character_propensities -. character-propensities .-> Remediate

    %% Arrow 69: ReEvaluate
    Remediate -- transcript --> ReEvaluate
    evaluation_rubrics -. evaluation-rubrics .-> ReEvaluate
    DraftCharter -. charter .-> ReEvaluate
    ReEvaluate -- transcript --> transcript

    %% Arrow 77: HumanGate
    QualityGate -- passed-evaluation --> HumanGate
    Resolve -- resolution --> HumanGate
    HumanGate -- "rejected-resolution" --> rejected_resolution_sink

    %% --- Styling ---

    %% Operations: dark boxes (fan=blue, funnel=green, enrichment=outlined, gate=purple)
    style FrameSituation fill:#2d2d2d,stroke:#000,color:#fff,stroke-width:2px
    style Fan fill:#1a3a5c,stroke:#0d47a1,color:#bbdefb,stroke-width:2px
    style AssessScenarios fill:#e8eaf6,stroke:#3949ab,color:#1a237e,stroke-width:2px
    style CoverageGate fill:#4a148c,stroke:#6a1b9a,color:#e1bee7,stroke-width:2px
    style DraftCharter fill:#2d2d2d,stroke:#000,color:#fff,stroke-width:2px
    style Convene fill:#2d2d2d,stroke:#000,color:#fff,stroke-width:2px
    style Deliberate fill:#1b5e20,stroke:#2e7d32,color:#c8e6c9,stroke-width:2px
    style Resolve fill:#2d2d2d,stroke:#000,color:#fff,stroke-width:2px
    style Evaluate fill:#e8eaf6,stroke:#3949ab,color:#1a237e,stroke-width:2px
    style QualityGate fill:#2d2d2d,stroke:#000,color:#fff,stroke-width:2px
    style Remediate fill:#2d2d2d,stroke:#000,color:#fff,stroke-width:2px
    style ReEvaluate fill:#e8eaf6,stroke:#3949ab,color:#1a237e,stroke-width:2px
    style HumanGate fill:#4a148c,stroke:#6a1b9a,color:#e1bee7,stroke-width:2px

    %% Source types: light rounded
    style character_propensities fill:#f5f5f5,stroke:#999,color:#333
    style coverage_criteria fill:#f5f5f5,stroke:#999,color:#333
    style evaluation_rubrics fill:#f5f5f5,stroke:#999,color:#333
    style raw_problem fill:#f5f5f5,stroke:#999,color:#333
    style remediation_threshold fill:#f5f5f5,stroke:#999,color:#333
    style roberts_rules fill:#f5f5f5,stroke:#999,color:#333
    style scenario_parameters fill:#f5f5f5,stroke:#999,color:#333
    style scenario_roster fill:#f5f5f5,stroke:#999,color:#333
    style scenario_rubric fill:#f5f5f5,stroke:#999,color:#333

    %% Waste sinks: red
    style gaps_identified_sink fill:#fee,stroke:#c00,color:#c00,stroke-width:2px
    style rejected_resolution_sink fill:#fee,stroke:#c00,color:#c00,stroke-width:2px