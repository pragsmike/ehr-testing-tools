;; St. Aldric's Memorial -- the deliberately gaudy second profile,
;; docs/site-profiles.md's own invariance-property demo (Task 4).
;; A different HL7 version, a renamed sending facility, an overridden
;; patient-class/discharge-disposition code, and a ZPI payer Z-segment.
{:site-profile
 {:name "St. Aldric's Memorial"
  :msh {:version "2.5.1"
        :sending-app "ALDRIC-EHR"
        :sending-facility "ALDRIC"
        :receiving-app "DOWNSTREAM"
        :receiving-facility "DOWNSTREAM-FAC"}
  :code-tables {:patient-class {:inpatient {:code "IN" :coding-system "99ALDRIC"}}
                :discharge-disposition {:discharged-to-home {:code "HOME" :coding-system "99ALDRIC"}}}
  :z-segments [{:segment "ZPI"
                :trigger #{:admission}
                :fields [{:path [:persona :payer :id]}
                         {:path [:persona :payer :type]}
                         {:literal "ALDRIC-PAYER-V1"}]}]}}
