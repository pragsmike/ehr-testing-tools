;; docs/demos/module-mix/config.edn -- the full vendored GMF module set,
;; weighted for a mixed population (docs/gmf-interpreter.md's M7 default
;; :modules assignment). Run with:
;;
;;   bin/ehrt sim run --seed 7 --patients 100 \
;;     --config docs/demos/module-mix/config.edn --churn --emit hl7 --format er7
;;
;; :pathway is an explicit EMPTY authored pathway (the documented shape
;; for module-only patients, ehrt.sim.run's own :modules docstring
;; -- module-compiled content is prepended onto whatever :pathway/:pathways
;; queues, never replaces it; an empty pathway means EVERY patient's
;; clinical content comes from their assigned module, none from hand-
;; authored steps). :module-horizon-days 3650 (10 years) gives a real
;; onset -- especially appendicitis.json's own age-bracket Delay, which
;; can run up to decades -- realistic room to land inside the horizon
;; window rather than being dropped as a pre-horizon fact.
{:pathway {:name "module-only" :steps []}
 :modules ["sinusitis" "appendicitis"]
 :module-assignment [{:module-id "sinusitis" :weight 90}
                      {:module-id "appendicitis" :weight 10}]
 :module-horizon-days 3650}
