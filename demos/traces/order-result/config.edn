;; demos/traces/order-result/config.edn -- the --config passthrough vehicle
;; (Milestone M4 Task 0) for a data-heavy key (:pathways) that has no CLI
;; flag of its own. Run with:
;;
;;   bin/ehrt sim run --seed 42 --patients 3 \
;;     --config demos/traces/order-result/config.edn --emit hl7
;;
;; This demo proves Task 0's own wiring fix end to end THROUGH the CLI --
;; the same :pathways value engine-test already exercised via the direct
;; engine/run API now reaches the engine from a real CLI invocation too.
{:pathways [{:pathway {:name "cbc-order"
                       :steps [{:type :admission :location "Renal"}
                               {:type :order :profile :cbc}
                               {:type :discharge}]}
             :weight 1}]}
