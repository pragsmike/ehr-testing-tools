  {:sha "fecbe43b"
   :date "2026-09-30"
   :machine "WSL2, 6c/12t i7-10750H, 15 GiB, OpenJDK 21.0.7, -Xmx8g explicit (clojure -J-Xmx8g -M:ehrt, the alias bin/ehrt execs)"
   :command "sim run --seed 20260824 --patients 28024 --churn --config demos/scenarios/dense-7500/config-28024.edn --format ground-truth"
   :method "one run here, /usr/bin/time -v around the whole process, JVM startup included. :bytes is the stdout event vector's own length; :events and :subjects are `ehrt sim describe`'s over that vector."
   :events-sha256 "ee59219eb81eb07fb18aa854781ace63e6b210909417762627675e8c96dd29a4"
   ;; THE PRE-REBASELINE LOG, kept as history. ADR-0185 (2026-09-30)
   ;; moved every churn-bearing corpus: reinstated stays now close after
   ;; a delay, and churn's candidate choice is in patient-id order. The
   ;; log below is what this cell wrote before that, at dac3d9c8, and it
   ;; was independently reproduced byte for byte downstream on another
   ;; host and JDK build, from that run's own re-serialization of
   ;; config.edn with :persons {:count 56048} (sha-256 prefix 7f7070,
   ;; not in this tree) -- VALUE-equal to config-28024.edn, not
   ;; byte-equal. It is a valid pre-rebaseline artifact; it is not what
   ;; the command above writes today.
   :pre-rebaseline {:sha "dac3d9c8" :date "2026-09-30"
                    :events 668496 :bytes 263570096 :wall-s 383.10 :peak-rss-mb 3599
                    :events-sha256 "589600c5a8051ff2cad2fd4a82eddc67b52fe7d1cd338ebdaa477298549cc335"
                    :downstream-config-sha256-prefix "7f7070"}}}

