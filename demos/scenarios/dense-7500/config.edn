;; demos/scenarios/dense-7500/config.edn -- the dense scale scenario,
;; committed. Until 2026-09-04 this configuration existed only as
;; session scratch: the 2026-08-24 throughput spike authored it with a
;; `gen-config.py` that was never committed (that session's F1), the
;; 2026-08-29 traffic-scale close appended nine opt-in keys to it with a
;; `gen-v2.py` that was never committed either, and
;; `docs/consuming-ground-truth.md`'s Scale table has cited the
;; resulting figures ever since. The scratch did not survive a third
;; arc. This file is that configuration re-authored from the two
;; records' own descriptions and committed, so the table's cells have a
;; runnable artifact under them rather than a dead directory.
;;
;; WHAT IS RE-AUTHORED AND WHAT IS FROZEN. The SKELETON below -- the
;; facility, the providers, the three weighted pathways, the arrival
;; gap, the module cohort -- comes from
;; `.agents/session-records/2026-08-24-throughput-spike.md`'s own
;; "The scenario, in full" section, which describes the scenario in
;; prose and not in bytes: step COUNTS, ward sizes, weights and the
;; cohort stride are its, the individual step contents are this
;; session's, and the original bytes are unrecoverable. The NINE OPT-IN
;; KEYS at the bottom are frozen verbatim to
;; `.agents/session-records/2026-08-29-traffic-scale-close.md` section
;; 3's table, mismatches and all -- see the block above `:scheduling`.
;;
;; EVERY CODE HERE IS ALREADY IN THIS TREE, none invented: the SNOMED
;; and RxNorm concepts are lifted from the vendored Synthea modules
;; under `components/sim/resources/sim/modules/` (`injuries.json`,
;; `sore_throat.json`, `osteoporosis.json`), the LOINC observation code
;; from the same, and the `:cbc`/`:bmp` order profiles are the shipped
;; catalytic in `components/sim-engine/resources/sim-engine/
;; order-profiles.edn`. No CPT anywhere (`sim/F4`).
;;
;; THE SCALE IS THE POINT. This is the only scenario in `demos/` sized
;; for a 10^5-event corpus; `clinic-decade` and `ed-tuesday` are 200-
;; and 100-patient scenarios a reader runs in under a minute. Expect
;; minutes, not seconds -- see this directory's own README for measured
;; walls, and `docs/consuming-ground-truth.md#scale` for the cells this
;; file is the provenance of.
;;
;; DERIVED SIBLINGS. `config-nobed.edn` is this file with its one
;; `:bed-cycle true` line removed; `config-bare.edn` is this file's own
;; byte PREFIX, ending where the nine opt-in keys begin. Both are
;; derived from these bytes and neither is independently authored.
{:facility {:id :metro-general
            ;; SIZED SO THE STEADY-STATE CENSUS NEVER REACHES THE SURGE
            ;; RUNGS -- the spike's own sizing rule, restated: a
            ;; capacity-exhausted run measures the error path rather
            ;; than generation, and `:exhausted` HALTS a run outright
            ;; (ADR-0174). Emergency is the arrival ward; the three
            ;; inpatient wards take the transfers.
            :wards [{:id :ed :name "Emergency" :beds 180 :surge-slots 40
                     :surge-format "%s-H%02d" :class :ed :turnaround-minutes [5 15]}
                    {:id :medicine-a :name "Medicine A" :beds 200 :surge-slots 40
                     :surge-format "%s-H%02d" :class :inpatient :turnaround-minutes [15 30]}
                    {:id :medicine-b :name "Medicine B" :beds 200 :surge-slots 40
                     :surge-format "%s-H%02d" :class :inpatient :turnaround-minutes [15 30]}
                    {:id :surgery :name "Surgery" :beds 160 :surge-slots 40
                     :surge-format "%s-H%02d" :class :inpatient :turnaround-minutes [15 30]}]}
 ;; FOUR PROVIDERS, BETWEEN THEM ELIGIBLE FOR ALL FOUR WARDS -- the
 ;; spike's own F5-3 finding, which is that a ward with no eligible
 ;; attending is a run that stops. Dr. Vance is eligible everywhere,
 ;; the same escape the shipped `default-provider-templates` gives
 ;; Dr. Reyes.
 :providers [{:name {:family "Vance" :given "Ruth"} :role :attending
              :specialty "Emergency Medicine" :wards [:ed :medicine-a :medicine-b :surgery]}
             {:name {:family "Aoki" :given "Kenji"} :role :attending
              :specialty "Internal Medicine" :wards [:medicine-a]}
             {:name {:family "Ferreira" :given "Luisa"} :role :attending
              :specialty "Hospital Medicine" :wards [:medicine-b]}
             {:name {:family "Osei" :given "Kwame"} :role :attending
              :specialty "General Surgery" :wards [:surgery]}]
 ;; ~ONE ARRIVAL A MINUTE (uniform 0..2). The arrival RATE is fixed and
 ;; only `--patients` grows, so the concurrent census is the same at
 ;; every scale point and a log-log slope over this scenario measures
 ;; the algorithm rather than a busier hospital -- the spike's own
 ;; reason for holding it constant.
 :arrival-gap 2
 :pathways [;; The dense inpatient stay: 21 steps, and the one that
            ;; carries every clinical step type this pathway IR has --
            ;; two lab orders, two medication spans, a care plan, a
            ;; procedure and a diagnostic report, bracketed by a
            ;; transfer. This is where the generate-phase work is.
            {:pathway {:name "dense-inpatient"
                       :steps [{:type :admission :location "Emergency" :reason "Acute abdominal pain"}
                               {:type :delay :from 30 :to 90}
                               {:type :order :profile :cbc}
                               {:type :delay :from 45 :to 120}
                               {:type :medication-order
                                :codes [{:system :rxnorm :code "834102"
                                         :display "Penicillin V Potassium 500 MG Oral Tablet"}]
                                :citation {:module "dense-inpatient" :state :antibiotic-start}}
                               {:type :transfer :location "Medicine A"}
                               {:type :delay :from 120 :to 480}
                               {:type :order :profile :bmp}
                               {:type :observation
                                :codes [{:system :loinc :code "8310-5" :display "Body temperature"}]
                                :value 38.4 :unit "Cel"}
                               {:type :care-plan-start
                                :codes [{:system :snomed :code "385691007"
                                         :display "Fracture care (regime/therapy)"}]
                                :citation {:module "dense-inpatient" :state :care-plan}}
                               {:type :delay :from 240 :to 720}
                               {:type :procedure
                                :codes [{:system :snomed :code "274474001"
                                         :display "Bone immobilization (procedure)"}]}
                               {:type :diagnostic-report
                                :codes [{:system :loinc :code "38265-5"
                                         :display "DXA Radius and Ulna [T-score] Bone density"}]
                                :observations [{:codes [{:system :loinc :code "38265-5"
                                                         :display "DXA Radius and Ulna [T-score] Bone density"}]
                                                :value -1.4 :unit "{T-score}"}]}
                               {:type :order :profile :cbc}
                               {:type :delay :from 120 :to 360}
                               {:type :medication-order
                                :codes [{:system :rxnorm :code "904419"
                                         :display "Alendronic acid 10 MG Oral Tablet"}]
                                :citation {:module "dense-inpatient" :state :analgesia-start}}
                               {:type :observation
                                :codes [{:system :loinc :code "8310-5" :display "Body temperature"}]
                                :value 37.1 :unit "Cel"}
                               {:type :medication-end
                                :order-citation {:module "dense-inpatient" :state :antibiotic-start}}
                               {:type :medication-end
                                :order-citation {:module "dense-inpatient" :state :analgesia-start}}
                               {:type :care-plan-end
                                :care-plan-citation {:module "dense-inpatient" :state :care-plan}}
                               {:type :discharge}]}
             :weight 45}
            ;; Worked up in the ED and sent home: 8 steps, no transfer,
            ;; no bed on an inpatient ward.
            {:pathway {:name "dense-fast"
                       :steps [{:type :admission :location "Emergency" :reason "Chest pain, low risk"}
                               {:type :delay :from 30 :to 90}
                               {:type :order :profile :cbc}
                               {:type :delay :from 60 :to 150}
                               {:type :observation
                                :codes [{:system :loinc :code "8310-5" :display "Body temperature"}]
                                :value 36.9 :unit "Cel"}
                               {:type :procedure
                                :codes [{:system :snomed :code "305433001"
                                         :display "Admission to trauma surgery department (procedure)"}]}
                               {:type :delay :from 45 :to 120}
                               {:type :discharge}]}
             :weight 35}
            ;; Taken to theatre: 12 steps, the surgical ward's own
            ;; traffic and the second care-plan span in the pool.
            {:pathway {:name "dense-surgical"
                       :steps [{:type :admission :location "Emergency" :reason "Suspected appendicitis"}
                               {:type :delay :from 30 :to 90}
                               {:type :order :profile :cbc}
                               {:type :transfer :location "Surgery"}
                               {:type :delay :from 60 :to 240}
                               {:type :procedure
                                :codes [{:system :snomed :code "305428000"
                                         :display "Admission to orthopedic department (procedure)"}]}
                               {:type :delay :from 120 :to 360}
                               {:type :care-plan-start
                                :codes [{:system :snomed :code "225358003"
                                         :display "Wound care (regime/therapy)"}]
                                :citation {:module "dense-surgical" :state :care-plan}}
                               {:type :observation
                                :codes [{:system :loinc :code "8310-5" :display "Body temperature"}]
                                :value 37.6 :unit "Cel"}
                               {:type :delay :from 240 :to 960}
                               {:type :care-plan-end
                                :care-plan-citation {:module "dense-surgical" :state :care-plan}}
                               {:type :discharge}]}
             :weight 20}
            ;; THE MODULE COHORT, EVERY EIGHTH ORDINAL. Disjoint from
            ;; the three weighted pathways above by explicit ordinal --
