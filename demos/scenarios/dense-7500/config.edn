 ;; ---------------------------------------------------------------
 ;; THE NINE OPT-IN KEYS. Everything above this line is
 ;; `config-bare.edn`, byte for byte -- the "no opt-in key at all" cell
 ;; of `docs/consuming-ground-truth.md#scale`, and the configuration
 ;; the 2026-08-24 spike and the 2026-08-25 arc-0 continuity series
 ;; both ran. Everything below it is what the 2026-08-29 traffic-scale
 ;; close appended.
 ;;
 ;; THE VALUES ARE FROZEN TO THAT SESSION'S OWN TABLE and are NOT
 ;; retuned here (R-values, 2026-09-04). Two of them are disclosed
 ;; MISMATCHES, in that record's own words, and they stay mismatched so
 ;; that the cells this file is the provenance of remain the cells that
 ;; were measured:
 ;;
 ;;   `:scheduling` -- clinic-decade's numbers, copied. Those are a
 ;;   booked ambulatory decade's; this is an acute metro hospital, for
 ;;   which ed-tuesday's 0.15 scheduled fraction would be the clinical
 ;;   choice rather than 0.70.
 ;;
 ;;   `:chatter` -- clinic-decade's 0.25 restatements per patient-day
 ;;   against ed-tuesday's 0.02, so this scenario carries an ambulatory
 ;;   census rate over acute traffic and is biased toward MORE chatter
 ;;   than its own shape would produce.
 ;;
 ;; `:persons :count` is the one value that is a RULE rather than a
 ;; copy: twice the arrival count (clinic-decade's own block derives
 ;; the factor). At 7,500 arrivals that is 15,000 people; clinic-
 ;; decade's literal 400 would collide nearly every arrival onto an
 ;; already-registered person. `:years` is copied.
 :persons {:count 15000 :years 20}
 :encounters true
 :bed-cycle true
 :scheduling {:scheduled-fraction 0.70
              :lead-time-days [3 21]
              :no-show-rate 0.15
              :reschedule-rate 0.10
              :cancel-rate 0.08
              :follow-up {:rate 0.35 :interval-days [30 120]}}
 :chatter {:demographic-update 1.0
           :coverage-change 1.0
           :registered 1.0
           :restatement {:rate-per-patient-day 0.25}}
 :charges {:price-table {"58410-2"   {:amount 148.00 :display "CBC panel"}
                         "117015009" {:amount 62.00 :display "Throat culture"}
                         "23426006"  {:amount 210.00 :display "Respiratory function measurement"}
                         "441550005" {:amount 88.00 :display "Urinalysis with reflex to culture"}
                         "ROOM-BOARD" {:amount 1875.00 :display "Room and board, per day"}}}
 :ladders {:rungs [0.5] :order-rungs [0.25]}
 :siu {}
 :fan-out [{:name :adt-feed
            :filter {:message-types #{"ADT^A01" "ADT^A02" "ADT^A03"}}
            :msh {:receiving-app "ADT-CONSUMER" :receiving-facility "CENTRAL"}}
           {:name :bed-feed
            :filter {:message-types #{"ADT^A01" "ADT^A20"}
                     :patient-classes #{:inpatient}}
            :msh {:receiving-app "BED-MANAGEMENT" :receiving-facility "CENTRAL"}}]}
