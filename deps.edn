{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        metosin/malli {:mvn/version "0.20.1"}
        org.babashka/cli {:mvn/version "0.12.79"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        ;; HAPI FHIR (EXP-B2): parse-validation aid and round-trip
        ;; comparison baseline for FHIR JSON -- current stable per
        ;; Maven Central, verified 2026-07-24 (facts register F13).
        ca.uhn.hapi.fhir/hapi-fhir-base {:mvn/version "8.2.0"}
        ca.uhn.hapi.fhir/hapi-fhir-structures-r4 {:mvn/version "8.2.0"}
        ;; HAPI HL7v2 (EXP-B2): ER7 parse/serialize round-trip fidelity
        ;; measurement. Distinct project from HAPI FHIR -- distinct
        ;; Maven coordinates (ca.uhn.hapi, not ca.uhn.hapi.fhir).
        ;; Current stable per Maven Central, verified 2026-07-24
        ;; (facts register F13); matches the v2.6.0 already recorded in
        ;; facts register F3.
        ca.uhn.hapi/hapi-base {:mvn/version "2.6.0"}
        ca.uhn.hapi/hapi-structures-v24 {:mvn/version "2.6.0"}}

 :aliases
 {;; Test runner. Same coordinates and pin as ehr-testing-guide/companion's
  ;; :test alias, so `clojure -X:test` means the same thing in both repos.
  ;; test.check is here (not in base :deps) because generative property
  ;; tests (ADR-0006) are a test-only concern.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
         :exec-fn cognitect.test-runner.api/test
         ;; Hermeticity is now a PATH split, not a tag filter: tests
         ;; that need the network or a real external engine live under
         ;; test-integration/, not test/, so :extra-paths above simply
         ;; never puts them on this alias's classpath -- see the
         ;; :integration alias below. The ^:integration metadata on
         ;; those tests (e.g. contract_pairing_test.clj) stays as
         ;; documentation of *why* they moved, not as the exclusion
         ;; mechanism; :excludes here is now redundant belt-and-braces
         ;; (harmless -- nothing on this alias's path carries the tag
         ;; any more) rather than load-bearing.
         :exec-args {:excludes [:integration]}}

  ;; Integration suite (2026-07-25 CI hotfix): tests that require real
  ;; cached artifacts, network, or a warm cache -- e.g. judge.fhir's
  ;; contract-pairing suite, which runs the real validator_cli.jar
  ;; subprocess against a real generated corpus. Excluded from :test's
  ;; and :coverage's classpaths by construction (neither alias adds
  ;; "test-integration" to its paths) -- this alias is the only one
  ;; that runs them. Requires `ehr artifact fetch` for synthea,
  ;; temurin-jdk, and fhir-validator-cli first (see `make help`).
  :integration {:extra-paths ["test-integration"]
                :extra-deps {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             org.clojure/test.check {:mvn/version "1.1.3"}}
                :exec-fn cognitect.test-runner.api/test
                :exec-args {:dirs ["test-integration"]}}

  ;; REPL/CIDER development. Jack in with this alias (e.g. `clojure -M:dev`
  ;; or your editor's jack-in command configured to include :dev). Mirrors
  ;; the companion's :dev alias.
  :dev {:extra-paths ["test"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                     cider/cider-nrepl {:mvn/version "0.50.2"}}
        :main-opts ["-m" "nrepl.cmdline" "--middleware"
                    "[cider.nrepl/cider-middleware]"]}

  ;; Coverage measurement (ADR-0006). `make coverage` / `clojure -M:coverage`.
  :coverage {:extra-paths ["test"]
             :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}
                           org.clojure/test.check {:mvn/version "1.1.3"}
                           org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
             :main-opts ["-m" "cloverage.coverage" "-p" "src" "-s" "test"]}}}
