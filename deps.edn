{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        ;; Schemas for config, the intermediate pathway representation,
        ;; the ground-truth log, and the manifest bridge. Same version
        ;; as ehr-testing-tools so a host process never sees two mallis.
        metosin/malli {:mvn/version "0.20.1"}
        ;; CLI parsing -- same lib and version as ehr-testing-tools'
        ;; `ehr` entrypoint, so mounting `sim` as an `ehr` subcommand
        ;; introduces no second CLI stack.
        org.babashka/cli {:mvn/version "0.12.79"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        ;; HL7v2 parse/emit (ER7). Verified coordinates from the
        ;; project's own project.clj (org.clojars.cmiles74 group).
        org.clojars.cmiles74/clojure-hl7-parser {:mvn/version "3.5.1"}}

 :aliases
 {;; Test runner. Same coordinates and pin as ehr-testing-tools' and
  ;; ehr-testing-guide/companion's :test aliases, so `clojure -X:test`
  ;; means the same thing in all three repos. test.check is test-only:
  ;; the determinism and invariant properties live in test/, never in
  ;; the shipped library.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      org.slf4j/slf4j-nop {:mvn/version "2.0.17"}}
         :exec-fn cognitect.test-runner.api/test}

  ;; Standalone CLI: `clojure -M:cli run --seed 42 ...`.
  ;; The same dispatch surface is exported for embedding as
  ;; `ehr sim <verb>` -- see ehr-testing-sim.cli's docstring and
  ;; notes/ADRs.md ADR-0001.
  :cli {:main-opts ["-m" "ehr-testing-sim.cli"]}}}
