{;; NIST v2-validation engine (judge-v2-nist, ADR-0012): its three
 ;; gov.nist coordinates resolve from NIST's own Nexus, not Maven
 ;; Central -- :mvn/repos is only honored at the root deps.edn, never
 ;; a component's own.
 :mvn/repos {"nist-hit" {:url "https://hit-nexus.nist.gov/repository/releases/"}}

 :aliases  {:dev {:extra-paths ["development/src"]

                  :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                               poly/sim      {:local/root "components/sim"}
                               poly/sim-cli  {:local/root "bases/sim-cli"}
                               ;; kernel/judge (ADR-0008): tools' own src
                               ;; now requires both directly.
                               poly/kernel   {:local/root "components/kernel"}
                               poly/judge    {:local/root "components/judge"}
                               ;; judge-v2-hapi/judge-fhir-official
                               ;; (ADR-0011): the per-engine judge split
                               ;; -- tools' own interface now requires
                               ;; both directly too.
                               poly/judge-v2-hapi        {:local/root "components/judge-v2-hapi"}
                               poly/judge-fhir-official  {:local/root "components/judge-fhir-official"}
                               ;; judge-v2-nist (ADR-0012): the third
                               ;; judge engine, profile-tier NIST
                               ;; v2-validation, direct (no CDC wrapper).
                               poly/judge-v2-nist        {:local/root "components/judge-v2-nist"}
                               poly/tools    {:local/root "components/tools"}
                               poly/palgebra {:local/root "components/palgebra"}
                               poly/cli      {:local/root "bases/cli"}}}

            :test {:extra-paths ["components/sim/test"
                                  "bases/sim-cli/test"
                                  "components/kernel/test"
                                  "components/judge/test"
                                  "components/judge-v2-hapi/test"
                                  "components/judge-fhir-official/test"
                                  "components/judge-v2-nist/test"
                                  "components/tools/test"
                                  "components/palgebra/test"
                                  "bases/cli/test"
                                  "projects/conformance/test"
                                  "projects/integration/test"]}

            ;; `bin/ehrt`'s own invocation alias (R32: the CLI tool is
            ;; renamed ehr -> ehrt, "e-heart" -- ehr stays reserved for
            ;; future payload-EHR tooling, ADR-0009). Runs from the
            ;; workspace root (not a project subdirectory) because
            ;; artifacts.lock.edn, config/, resources/synthea-default.properties,
            ;; and components/tools/test-fixtures/** are all cwd-relative
            ;; literal paths in ehrt.tools.* code (not classpath
            ;; resources) -- landing-session finding, see notes/ADRs.md
            ;; ADR-0002.
            :ehrt {:extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                                poly/kernel   {:local/root "components/kernel"}
                                poly/judge    {:local/root "components/judge"}
                                poly/judge-v2-hapi        {:local/root "components/judge-v2-hapi"}
                                poly/judge-fhir-official  {:local/root "components/judge-fhir-official"}
                                poly/judge-v2-nist        {:local/root "components/judge-v2-nist"}
                                poly/tools    {:local/root "components/tools"}
                                poly/palgebra {:local/root "components/palgebra"}
                                poly/cli      {:local/root "bases/cli"}
                                ;; The `ehrt sim` mount (ADR-0004, ADR-0012
                                ;; fulfilled) -- in-process, no subprocess.
                                poly/sim      {:local/root "components/sim"}}
                   :main-opts ["-m" "ehrt.cli.core"]}

            :poly {:main-opts ["-m" "polylith.clj.core.poly-cli.core"]
                   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                   :extra-deps {polylith/clj-poly {:mvn/version "0.3.32"}}}}}
