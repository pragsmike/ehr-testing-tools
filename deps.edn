{;; NIST v2-validation engine (judge-v2-nist, ADR-0012): its three
 ;; gov.nist coordinates resolve from NIST's own Nexus, not Maven
 ;; Central -- :mvn/repos is only honored at the root deps.edn, never
 ;; a component's own.
 :mvn/repos {"nist-hit" {:url "https://hit-nexus.nist.gov/repository/releases/"}}

 :aliases  {:dev {:extra-paths ["development/src"]

                  :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                               poly/sim      {:local/root "components/sim"}
                               ;; sim-engine (sim split B, M2, 2026-08-04,
                               ;; .agents/plans/2026-08-04-sim-split-b-
                               ;; plan.md, notes/ADRs.md ADR-0043): the
                               ;; discrete-event engine plus churn/order-
                               ;; profiles, extracted out of sim -- sim's
                               ;; own src now reaches these only through
                               ;; ehrt.sim-engine.interface.
                               poly/sim-engine {:local/root "components/sim-engine"}
                               ;; sim-model (sim split S1, .agents/plans/
                               ;; 2026-08-02-sim-split-plan.md): pathway/
                               ;; facility/persona/config, extracted out of
                               ;; sim -- sim's own src now reaches these
                               ;; only through ehrt.sim-model.interface.
                               poly/sim-model {:local/root "components/sim-model"}
                               ;; sim-trajectory (sim split S2, .agents/plans/
                               ;; 2026-08-02-sim-split-plan.md): gmf/gmf-
                               ;; interpreter/compile-trajectory, extracted
                               ;; out of sim -- sim's own src now reaches
                               ;; these only through
                               ;; ehrt.sim-trajectory.interface.
                               poly/sim-trajectory {:local/root "components/sim-trajectory"}
                               ;; sim-emit-hl7 (sim split S3 / Wave D stage
                               ;; D0, ADR-0029/ADR-0025): emit-hl7/v2-replay/
                               ;; site-profile, extracted out of sim -- sim's
                               ;; own src now reaches these only through
                               ;; ehrt.sim-emit-hl7.interface.
                               poly/sim-emit-hl7 {:local/root "components/sim-emit-hl7"}
                               ;; sim-emit-fhir (sim split B, M3, 2026-08-04,
                               ;; .agents/plans/2026-08-04-sim-split-b-
                               ;; plan.md, notes/ADRs.md ADR-0043): the
                               ;; state-based FHIR emitter, extracted out of
                               ;; sim -- sim's own src now reaches it only
                               ;; through ehrt.sim-emit-fhir.interface.
                               poly/sim-emit-fhir {:local/root "components/sim-emit-fhir"}
                               ;; sim-check (sim split B, M4, 2026-08-04,
                               ;; .agents/plans/2026-08-04-sim-split-b-
                               ;; plan.md, notes/ADRs.md ADR-0043): the
                               ;; invariant catalog, extracted out of sim --
                               ;; sim's own src now reaches it only through
                               ;; ehrt.sim-check.interface.
                               poly/sim-check {:local/root "components/sim-check"}
                               ;; kernel/judge (ADR-0008): corpus' own
                               ;; src requires both directly; sim's own
                               ;; src requires kernel directly too
                               ;; (ADR-0022, 2026-08-01 -- sim adopts
                               ;; ehrt.kernel.result, retiring its own
                               ;; copied envelope).
                               poly/kernel   {:local/root "components/kernel"}
                               poly/judge    {:local/root "components/judge"}
                               ;; judge-v2-hapi/judge-fhir-official
                               ;; (ADR-0011): the per-engine judge split.
                               ;; Since stage 3 (ADR-0018) bases/cli
                               ;; requires each engine interface
                               ;; directly -- the corpus domain itself
                               ;; has no judge-engine edge.
                               poly/judge-v2-hapi        {:local/root "components/judge-v2-hapi"}
                               poly/judge-fhir-official  {:local/root "components/judge-fhir-official"}
                               ;; judge-v2-nist (ADR-0012): the third
                               ;; judge engine, profile-tier NIST
                               ;; v2-validation, direct (no CDC wrapper).
                               poly/judge-v2-nist        {:local/root "components/judge-v2-nist"}
                               ;; provenance (sim split B, M1, 2026-08-04,
                               ;; .agents/plans/2026-08-04-sim-split-b-plan.md
                               ;; AR-2): ManifestV0/V1/V1_1 schemas +
                               ;; validators, the single acyclic home
                               ;; both corpus and sim depend on now.
                               poly/provenance {:local/root "components/provenance"}
                               ;; corpus (2026-07-31, split stage 3,
                               ;; ADR-0018): the corpus domain -- the
                               ;; former tools component, renamed and
                               ;; narrowed to a designed interface.
                               poly/corpus   {:local/root "components/corpus"}
                               ;; corpus-io (2026-07-31, refactoring-
                               ;; review split stage 2, ADR-0017):
                               ;; transport/IO seam -- corpus' own
                               ;; domain namespaces (mutate/operators/
                               ;; intake/generator-source) and bases/cli
                               ;; require it directly.
                               poly/corpus-io {:local/root "components/corpus-io"}
                               ;; docs-tooling (2026-07-31, refactoring-
                               ;; review split stage 1): dev-time-only
                               ;; doc/lint tooling. bases/cli/help.clj
                               ;; requires it directly (write-cli-md!)
                               ;; -- never through a domain relay (see
                               ;; ADR-0016's circular-dependency
                               ;; finding).
                               poly/docs-tooling {:local/root "components/docs-tooling"}
                               poly/palgebra {:local/root "components/palgebra"}
                               poly/cli      {:local/root "bases/cli"}
                               ;; oracle (standing-equipment promotion,
                               ;; 2026-08-05, `notes/ADRs.md` promotion
                               ;; ADR, AR-P-2): the regression-oracle
                               ;; digest producer, extracted out of
                               ;; bin/oracle-src -- a real project
                               ;; deploys nothing with it (its only real
                               ;; caller is bin/regression-oracle's own
                               ;; per-worktree synthetic classpath), but
                               ;; the dev REPL carries it like every
                               ;; other brick.
                               poly/oracle   {:local/root "components/oracle"}}}

            ;; `components/sim-trajectory/test`, below, also carries the
            ;; census tool's own co-landing tests since the standing-
            ;; equipment promotion (2026-08-05, `notes/ADRs.md` promotion
            ;; ADR, AR-P-1) moved them in from `development/test` -- no
            ;; separate `development/test` entry needed anymore;
            ;; `development/test` itself is now empty (ADR-0034's own
            ;; comment here, superseded).
            :test {:extra-paths ["components/sim/test"
                                  "components/sim-engine/test"
                                  "components/sim-model/test"
                                  "components/sim-trajectory/test"
                                  "components/sim-emit-hl7/test"
                                  "components/sim-emit-fhir/test"
                                  "components/sim-check/test"
                                  "components/kernel/test"
                                  "components/judge/test"
                                  "components/judge-v2-hapi/test"
                                  "components/judge-fhir-official/test"
                                  "components/judge-v2-nist/test"
                                  "components/provenance/test"
                                  "components/corpus/test"
                                  "components/corpus-io/test"
                                  "components/docs-tooling/test"
                                  "components/palgebra/test"
                                  "bases/cli/test"
                                  "projects/conformance/test"
                                  "projects/integration/test"]}

            ;; `bin/ehrt`'s own invocation alias (R32: the CLI tool is
            ;; renamed ehr -> ehrt, "e-heart" -- ehr stays reserved for
            ;; future payload-EHR tooling, ADR-0009). Runs from the
            ;; workspace root (not a project subdirectory) because
            ;; artifacts.lock.edn, config/, resources/synthea-default.properties,
            ;; and components/corpus/test-fixtures/** are all cwd-relative
            ;; literal paths in ehrt.corpus.* code (not classpath
            ;; resources) -- landing-session finding, see notes/ADRs.md
            ;; ADR-0002.
            :ehrt {:extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                                poly/kernel   {:local/root "components/kernel"}
                                poly/judge    {:local/root "components/judge"}
                                poly/judge-v2-hapi        {:local/root "components/judge-v2-hapi"}
                                poly/judge-fhir-official  {:local/root "components/judge-fhir-official"}
                                poly/judge-v2-nist        {:local/root "components/judge-v2-nist"}
                                ;; provenance (sim split B, M1, 2026-08-04):
                                ;; corpus' own src requires
                                ;; ehrt.provenance.interface directly.
                                poly/provenance {:local/root "components/provenance"}
                                poly/corpus   {:local/root "components/corpus"}
                                ;; corpus-io (2026-07-31, stage 2):
                                ;; corpus' own src and bases/cli both
                                ;; require it directly.
                                poly/corpus-io {:local/root "components/corpus-io"}
                                ;; docs-tooling (2026-07-31): bases/cli/
                                ;; help.clj requires it directly
                                ;; (write-cli-md!), so bin/ehrt's own
                                ;; classpath needs it too.
                                poly/docs-tooling {:local/root "components/docs-tooling"}
                                poly/palgebra {:local/root "components/palgebra"}
                                poly/cli      {:local/root "bases/cli"}
                                ;; The `ehrt sim` mount (ADR-0004, ADR-0012
                                ;; fulfilled) -- in-process, no subprocess.
                                ;; sim's own src requires poly/kernel
                                ;; directly too (ADR-0022, 2026-08-01).
                                poly/sim      {:local/root "components/sim"}
                                ;; sim-engine (sim split B, M2, 2026-08-04):
                                ;; sim's own src requires
                                ;; ehrt.sim-engine.interface.
                                poly/sim-engine {:local/root "components/sim-engine"}
                                ;; sim-model (sim split S1): sim's own src
                                ;; requires ehrt.sim-model.interface.
                                poly/sim-model {:local/root "components/sim-model"}
                                ;; sim-trajectory (sim split S2): sim's own
                                ;; src requires ehrt.sim-trajectory.interface.
                                poly/sim-trajectory {:local/root "components/sim-trajectory"}
                                ;; sim-emit-hl7 (sim split S3 / Wave D stage
                                ;; D0): sim's own src requires
                                ;; ehrt.sim-emit-hl7.interface.
                                poly/sim-emit-hl7 {:local/root "components/sim-emit-hl7"}
                                ;; sim-emit-fhir (sim split B, M3, 2026-08-04):
                                ;; sim's own src requires
                                ;; ehrt.sim-emit-fhir.interface.
                                poly/sim-emit-fhir {:local/root "components/sim-emit-fhir"}
                                ;; sim-check (sim split B, M4, 2026-08-04):
                                ;; sim's own src requires
                                ;; ehrt.sim-check.interface.
                                poly/sim-check {:local/root "components/sim-check"}}
                   :main-opts ["-m" "ehrt.cli.core"]}

            :poly {:main-opts ["-m" "polylith.clj.core.poly-cli.core"]
                   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                   :extra-deps {polylith/clj-poly {:mvn/version "0.3.32"}}}}}
