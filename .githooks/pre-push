#!/bin/sh
# Enforce: git operations on this repo happen from WSL, not native Windows
# (pushes are git operations too -- see .githooks/pre-commit), a secrets
# scan is clean, and `clojure -M:poly check` (dependency direction,
# interface boundaries) is green before anything leaves this clone. Same
# opt-in mechanism as pre-commit: this only fires once a clone has run
# `git config core.hooksPath .githooks`.
#
# Deliberately does NOT run tests. This gate is irreversibility-only --
# WSL provenance, a fail-closed secrets scan, and a fail-closed dependency
# check are all things that are expensive or impossible to undo once
# pushed; a failing test is not (CI catches it the next push, fixing it
# costs one more commit). See notes/ADRs.md ADR-0003 for the doctrine and
# why `poly test :project` was removed from this hook. See SETUP.md for
# hook installation and gitleaks install instructions.

is_wsl=0
if [ -n "$WSL_DISTRO_NAME" ]; then
  is_wsl=1
elif [ -r /proc/version ] && grep -qi microsoft /proc/version 2>/dev/null; then
  is_wsl=1
fi

if [ "$is_wsl" -ne 1 ]; then
  echo "ERROR: git pushes from this repo must be made from WSL, not $(uname -s 2>/dev/null || echo 'this shell')." >&2
  echo "  See AUTHORS-GUIDE.md, 'Git operations: WSL only', for why." >&2
  echo "  Re-run this push from a WSL shell instead." >&2
  exit 1
fi

fail() {
  echo "ERROR: $1 failed -- push refused." >&2
  echo "  Fix the failure, or in a genuine emergency: git push --no-verify" >&2
  exit 1
}

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "ERROR: gitleaks not found on PATH -- push refused." >&2
  echo "  Install it (see SETUP.md), or in a genuine emergency: git push --no-verify" >&2
  exit 1
fi

gitleaks detect --no-banner -v || fail "gitleaks detect"

clojure -M:poly check || fail "clojure -M:poly check"

exit 0
